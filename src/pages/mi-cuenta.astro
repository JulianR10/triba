---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import PDFViewer from "../components/PDFViewer.tsx";
import PatchTitle from "../components/PatchTitle.astro";

import { createSupabaseServerClient } from "../lib/supabase-server";
import { getEditions, getFeaturedEdition } from "../lib/editions";
import { getSignedPdfUrl } from "../lib/storage";
import { isActiveSubscription } from "../lib/subscription-status";
import type { Profile, Subscription } from "../lib/types";

const supabase = createSupabaseServerClient(Astro.request);
const { data: { session } } = await supabase.auth.getSession();
const user = session?.user ?? null;

let profile: Profile | null = null;
let subscription: Subscription | null = null;

if (user) {
  const { data: p } = await supabase.from("profiles").select("*").eq("id", user.id).single();
  profile = p;
  if (profile?.subscription_id) {
    const { data: s } = await supabase.from("subscriptions").select("*").eq("id", profile.subscription_id).single();
    subscription = s;
  }
}

const hasActiveSub = isActiveSubscription(subscription?.status ?? null);

const isAdmin = profile?.role === "admin";

const allEditions = await getEditions();
const featuredEdition = await getFeaturedEdition();

const editions = allEditions.map((e) => ({
  id: e.id,
  edition: `#${e.edition_number}`,
  title: e.title,
  description: e.description,
  cover: e.cover_url,
  pdf: e.pdf_url ? `/api/pdf/${e.id}` : "#",
  featured: e.featured,
  badge: e.badge,
  slug: `edicion-${e.edition_number}`,
  previewArticle: true,
}));

const editionsPayload = editions.map((e) => ({
  slug: e.slug,
  title: e.title,
  cover: e.cover,
  edition: e.edition,
}));

const featured = editions.find((e) => e.featured) || editions[0];
const featuredEditionRaw = featuredEdition ?? allEditions[0];
const featuredPdfSignedUrl = featuredEditionRaw?.pdf_url
  ? await getSignedPdfUrl(featuredEditionRaw.pdf_url).catch(() => null) ?? featured.pdf
  : undefined;

const checkoutStatus = Astro.url.searchParams.get("checkout");

const displayName = user?.user_metadata?.full_name || user?.email?.split("@")[0] || "lectora";
---

<Layout navLogoAlways>
  <section style="padding-top: max(1rem, var(--nav-height, 64px))">
    <div class="max-w-6xl mx-auto">

      {checkoutStatus === "success" && (
        <div data-banner="checkout-success" class="mx-5 md:mx-10 lg:mx-20 xl:mx-32 2xl:mx-48 mb-8 p-4 bg-triba-green/20 border-2 border-triba-green rounded-xl flex items-start justify-between gap-3 reveal" data-reveal>
          <div>
            <p class="font-heading text-sm uppercase tracking-wider text-triba-brown mb-1">¡Suscripción exitosa!</p>
            <p class="font-sans text-base text-triba-brown">Gracias por sumarte a Triba. Ya podés acceder a la revista desde tu perfil.</p>
          </div>
          <button type="button" data-dismiss-banner class="shrink-0 text-triba-brown hover:text-triba-red text-xl leading-none" aria-label="Cerrar">×</button>
        </div>
      )}

      {
        hasActiveSub && (
          <>

      <!-- ===== HERO ===== -->
      <div class="relative overflow-hidden rounded-none md:rounded-[32px] bg-gradient-to-br from-triba-pink via-triba-pink/60 to-triba-cream px-5 md:px-14 lg:px-20 py-10 md:py-16 lg:py-20 reveal" data-reveal>
        <div class="flex flex-col md:flex-row gap-8 md:gap-12 items-center">
          <div class="flex-1">
            <p class="font-heading text-sm md:text-base uppercase tracking-[0.2em] text-triba-brown/60 mb-4">Tu edición del mes</p>
            <h1 class="font-heading text-4xl sm:text-5xl md:text-6xl lg:text-7xl text-triba-brown leading-tight mb-2">
              Hola, <span class="text-triba-red">{displayName}</span>
            </h1>
            <div class="mt-6 mb-6">
              <h2 class="font-heading text-2xl md:text-3xl text-triba-brown">{featured.title}</h2>
            </div>
            <p class="font-sans text-base md:text-base text-triba-brown/80 leading-relaxed mb-8 max-w-lg whitespace-pre-line">
              {featured.description}
            </p>
            <div class="flex flex-wrap gap-4">
              {featured.pdf !== "#" && (
                <Button variant="primary" size="md" href="#visor-revista">Seguir leyendo</Button>
              )}
              {featured.pdf !== "#" && (
                <Button variant="ghost" size="md" href={`${featured.pdf}?download=1`}>Descargar PDF</Button>
              )}
            </div>
          </div>
          <div class="flex-1 flex justify-center md:justify-end">
            <div class="w-56 sm:w-64 md:w-72 lg:w-80 -rotate-[3deg] hover:rotate-0 transition-transform duration-500">
              <img src={featured.cover} alt={`Portada de ${featured.title}`} fetchpriority="high" class="w-full rounded-xl border-2 border-triba-black shadow-[8px_8px_0px_0px_rgba(0,0,0,0.15)]" />
            </div>
          </div>
        </div>
      </div>

      <!-- Admin banner -->
      {isAdmin && (
        <div class="mt-4 mx-5 md:mx-14 lg:mx-20 mb-8 reveal" data-reveal>
          <div class="bg-triba-green/30 rounded-xl border-2 border-triba-black p-6 text-center max-w-lg mx-auto">
            <p class="font-heading text-xs uppercase tracking-wider text-triba-brown mb-1">Sesión de administración</p>
            <p class="font-sans text-base text-triba-brown mb-4 text-balance">Estás logueada como <span class="font-bold">admin</span>. El panel de gestión está disponible desde acá.</p>
            <Button variant="primary" href="/admin">Ir al panel de administración</Button>
          </div>
        </div>
      )}

      <!-- ===== COLECCIÓN (carrusel "Tus tomos") ===== -->
      <div id="tus-tomos" class="px-5 md:px-14 lg:px-20 mt-12 md:mt-16 mb-12 md:mb-20 reveal" data-reveal>
        <div class="max-w-6xl mx-auto">
          <p class="font-heading text-xs uppercase tracking-[0.25em] text-triba-brown/50 mb-8">Tus tomos</p>

          <div class="relative" data-tomos-wrap>
            <button
              type="button"
              data-tomos-prev
              aria-label="Ver anteriores"
              class="absolute left-0 top-1/2 -translate-y-1/2 z-10 w-10 h-10 md:w-12 md:h-12 -ml-4 md:-ml-6 rounded-full bg-triba-white border-2 border-triba-black shadow-lg flex items-center justify-center font-sans text-xl text-triba-brown hover:bg-triba-pink transition-colors"
            >‹</button>

            <div
              data-tomos-track
              class="flex gap-4 md:gap-6 overflow-x-auto scrollbar-hide snap-x snap-mandatory"
            ></div>

            <button
              type="button"
              data-tomos-next
              aria-label="Ver siguientes"
              class="absolute right-0 top-1/2 -translate-y-1/2 z-10 w-10 h-10 md:w-12 md:h-12 -mr-4 md:-mr-6 rounded-full bg-triba-white border-2 border-triba-black shadow-lg flex items-center justify-center font-sans text-xl text-triba-brown hover:bg-triba-pink transition-colors"
            >›</button>
          </div>

          <div class="flex justify-center gap-2 mt-8" data-tomos-dots></div>
        </div>
      </div>

      <script type="application/json" data-tomos-data>{JSON.stringify(editionsPayload)}</script>

      <!-- ===== VISOR ===== -->
      <div class="bg-triba-cream w-full px-5 md:px-14 lg:px-20 xl:px-32 2xl:px-48 py-12 md:py-20">
        <div class="max-w-6xl mx-auto">
          {featured.pdf !== "#" && (
          <div id="visor-revista" class="scroll-anchor reveal" data-reveal>
            <PatchTitle content={featured.title} tag="h2" class="text-2xl md:text-3xl text-triba-brown mb-8" />

            <div class="-mx-5 md:mx-0">
              <PDFViewer pdfUrl={featuredPdfSignedUrl || ''} client:only="react" />
            </div>

            <p class="font-heading text-xs uppercase tracking-[0.2em] text-triba-brown/40 text-center mt-6">Deslizá o usá los botones para pasar las páginas</p>
          </div>
          )}
        </div>
      </div>

      <!-- ===== FEEDBACK ===== -->
      <div class="px-5 md:px-14 lg:px-20 py-12 md:py-16">
        <div class="max-w-lg mx-auto reveal" data-reveal>
          <h2 class="font-heading text-2xl md:text-3xl text-triba-brown text-center mb-8">Contanos qué te pareció</h2>

          <form id="feedback-form">
            <textarea
              name="feedback"
              rows="4"
              placeholder="¿Qué te gustó? ¿Qué cambiarías?..."
              maxlength="2000"
              class="w-full px-5 py-4 rounded-xl border-2 border-triba-black bg-triba-white font-sans text-sm text-triba-brown outline-none focus:border-triba-red transition-colors resize-none mb-3"
            ></textarea>
            <div class="flex items-center justify-between gap-4">
              <span id="feedback-counter" class="font-sans text-xs text-triba-brown/50">0 / 2000</span>
              <Button variant="primary" type="submit">Enviar</Button>
            </div>
            <p id="feedback-msg" class="font-sans text-sm text-center mt-3 hidden"></p>
          </form>
        </div>
      </div>

        </>
        )
      }

      {
        !hasActiveSub && (
          <div class="max-w-lg mx-auto mt-10 text-center reveal px-5" data-reveal>
            <div class="bg-triba-cream rounded-xl border-2 border-triba-black p-8">
              {
                checkoutStatus === "success" ? (
                  <>
                    <h2 class="font-heading text-base uppercase tracking-wider text-triba-brown mb-2">Procesando tu pago...</h2>
                    <p class="font-sans text-base text-triba-brown/70 mb-6 leading-relaxed">Estamos confirmando tu suscripción. Esto puede tardar unos segundos.</p>
                    <div class="flex justify-center">
                      <div class="w-6 h-6 border-2 border-triba-red border-t-2 border-t-transparent rounded-full animate-spin"></div>
                    </div>
                  </>
                ) : (
                  <>
                    <h2 class="font-heading text-base uppercase tracking-wider text-triba-brown mb-2">Todavía no tenés suscripción</h2>
                    <p class="font-sans text-base text-triba-brown/70 mb-6 leading-relaxed">Suscribite para acceder a la revista completa, el archivo histórico y la descarga PDF.</p>
                    <Button variant="primary" href="/suscribirme">Suscribirme</Button>
                  </>
                )
              }
            </div>
          </div>
        )
      }

    </div>
  </section>
</Layout>

<script>
  import { supabase } from "../lib/supabase";
  import { isActiveSubscription } from "../lib/subscription-status";
  import { onPageCycle } from "../lib/onPageCycle";

  function setup() {

  // --- Poll subscription after checkout ---
  var pollInterval: ReturnType<typeof setInterval> | null = null;
  var searchParams = new URLSearchParams(window.location.search);
  if (searchParams.get("checkout") === "success") {
    var attempts = 0;
    var maxAttempts = 12;

    pollInterval = setInterval(async function () {
      attempts++;
      if (attempts > maxAttempts) {
        if (pollInterval) clearInterval(pollInterval);
        return;
      }

      try {
        var { data: { session } } = await supabase!.auth.getSession();
        if (!session) return;

        var res = await fetch("/api/subscription-status", {
          headers: { Authorization: "Bearer " + session.access_token },
        });
        var data = await res.json();
        if (isActiveSubscription(data.subscription?.status)) {
          if (pollInterval) clearInterval(pollInterval);
          window.location.reload();
        }
      } catch {
        /* retry */
      }
    }, 3000);
  }

  // --- Tus tomos: carrusel paginado (mobile 2x2 / desktop 2 filas de 4) ---
  var dataEl = document.querySelector<HTMLElement>("[data-tomos-data]");
  if (dataEl) {
    var editionsList: { slug: string; title: string; cover: string; edition: string }[] = JSON.parse(dataEl.textContent || "[]");
    var wrap = document.querySelector<HTMLElement>("[data-tomos-wrap]");
    var track = wrap && wrap.querySelector<HTMLElement>("[data-tomos-track]");
    var dotsBox = document.querySelector<HTMLElement>("[data-tomos-dots]");
    var prevBtn = wrap && wrap.querySelector<HTMLButtonElement>("[data-tomos-prev]");
    var nextBtn = wrap && wrap.querySelector<HTMLButtonElement>("[data-tomos-next]");

    function tomosPerPage() {
      return window.matchMedia("(min-width: 768px)").matches ? 8 : 4;
    }

    function buildTomos() {
      if (!track || !dotsBox || !prevBtn || !nextBtn || !editionsList.length) return;
      var n = tomosPerPage();
      var pages: typeof editionsList[] = [];
      for (var i = 0; i < editionsList.length; i += n) {
        pages.push(editionsList.slice(i, i + n));
      }

      track.innerHTML = pages
        .map(function (page) {
          return (
            '<div class="flex-none w-full snap-start">' +
            '<div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">' +
            page
              .map(function (ed) {
                return (
                  '<a href="/revista/' + ed.slug + '#visor-revista" class="group block">' +
                  '<div class="aspect-[3/4] rounded-xl overflow-hidden border-2 border-triba-black shadow-lg transition-all duration-400 group-hover:rotate-0 group-hover:scale-[1.04] group-hover:shadow-2xl">' +
                  '<img src="' + ed.cover + '" alt="Portada ' + ed.edition + ' — ' + ed.title + '" loading="lazy" class="w-full h-full object-cover" />' +
                  "</div>" +
                  '<p class="font-heading text-xs uppercase tracking-wider text-triba-brown/60 text-center mt-2 leading-relaxed">' + ed.title + "</p>" +
                  "</a>"
                );
              })
              .join("") +
            "</div></div>"
          );
        })
        .join("");

      dotsBox.innerHTML = pages
        .map(function (_, i) {
          return (
            '<button type="button" data-tomos-dot="' + i + '" aria-label="Ir a página ' + (i + 1) + '" class="w-2.5 h-2.5 rounded-full bg-triba-brown/25 transition-all hover:scale-125"></button>'
          );
        })
        .join("");
      dotsBox.style.display = pages.length > 1 ? "" : "none";

      track.scrollLeft = 0;
      updateTomosUI();
    }

    function updateTomosUI() {
      if (!track || !prevBtn || !nextBtn || !dotsBox) return;
      var scrollLeft = track.scrollLeft;
      var width = track.clientWidth || 1;
      var idx = Math.round(scrollLeft / width);
      var maxIdx = Math.max(0, Math.round((track.scrollWidth - track.clientWidth) / width));
      prevBtn.style.opacity = idx <= 0 ? "0.35" : "1";
      nextBtn.style.opacity = idx >= maxIdx ? "0.35" : "1";
      dotsBox.querySelectorAll<HTMLButtonElement>("[data-tomos-dot]").forEach(function (d, i) {
        d.className = "w-2.5 h-2.5 rounded-full transition-colors " + (i === idx ? "bg-triba-red" : "bg-triba-brown/25");
      });
    }

    if (track && prevBtn && nextBtn && dotsBox) {
      track.addEventListener("scroll", updateTomosUI, { passive: true });
      prevBtn.addEventListener("click", function () {
        track!.scrollBy({ left: -(track!.clientWidth || 0), behavior: "smooth" });
      });
      nextBtn.addEventListener("click", function () {
        track!.scrollBy({ left: track!.clientWidth || 0, behavior: "smooth" });
      });
      dotsBox.addEventListener("click", function (e) {
        var b = (e.target as HTMLElement).closest("[data-tomos-dot]");
        if (b) {
          var idx = Number(b.getAttribute("data-tomos-dot"));
          track!.scrollTo({ left: idx * (track!.clientWidth || 1), behavior: "smooth" });
        }
      });
      var rsT: number | undefined;
      window.addEventListener("resize", function () {
        window.clearTimeout(rsT);
        rsT = window.setTimeout(buildTomos, 150);
      });
      buildTomos();
    }
  }

  // --- Feedback form ---
  const fbForm = document.getElementById("feedback-form");
  const fbMsg = document.getElementById("feedback-msg")!;
  const fbTextarea = fbForm?.querySelector("textarea[name=feedback]") as HTMLTextAreaElement | null;
  const fbCounter = document.getElementById("feedback-counter");
  const fbBtn = fbForm?.querySelector("button[type=submit]") as HTMLButtonElement | null;
  let fbTimer: number | undefined;

  const updateCounter = () => {
    if (!fbTextarea || !fbCounter) return;
    const len = fbTextarea.value.length;
    fbCounter.textContent = len + " / 2000";
    fbCounter.className = len > 2000
      ? "font-sans text-xs text-triba-red"
      : "font-sans text-xs text-triba-brown/50";
    if (fbBtn) fbBtn.disabled = len === 0 || len > 2000;
  };

  if (fbTextarea && fbCounter) {
    fbTextarea.addEventListener("input", updateCounter);
    updateCounter();
  }

  if (fbForm) {
    fbForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      fbMsg.classList.add("hidden");
      fbMsg.className = "font-sans text-sm text-center mt-3 hidden";
      window.clearTimeout(fbTimer);

      const mensaje = fbTextarea?.value;
      // Disable synchronously before the first await so a double-click can't fire twice
      if (fbBtn) {
        fbBtn.disabled = true;
        fbBtn.textContent = "Enviando...";
      }

      var { data: { session } } = await supabase!.auth.getSession();
      if (!session) {
        fbMsg.textContent = "Debés iniciar sesión para enviar feedback";
        fbMsg.className = "font-sans text-sm text-center text-triba-red mt-3";
        fbMsg.classList.remove("hidden");
        if (fbBtn) {
          fbBtn.disabled = false;
          fbBtn.textContent = "Enviar";
        }
        return;
      }

      try {
        const res = await fetch("/api/feedback", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Authorization: "Bearer " + session.access_token,
          },
          body: JSON.stringify({ mensaje }),
        });

        const data = await res.json().catch(() => ({}));

        if (res.status === 429) {
          fbMsg.textContent = data.error || "Esperá un momento antes de enviar otro feedback";
          fbMsg.className = "font-sans text-sm text-center text-triba-red mt-3";
        } else if (!res.ok) {
          fbMsg.textContent = data.error || "Error al enviar. Intentalo de nuevo.";
          fbMsg.className = "font-sans text-sm text-center text-triba-red mt-3";
        } else {
          fbMsg.textContent = "¡Gracias por tu feedback!";
          fbMsg.className = "font-sans text-sm text-center text-triba-red mt-3";
          if (fbTextarea) fbTextarea.value = "";
          updateCounter();
          window.clearTimeout(fbTimer);
          fbTimer = window.setTimeout(() => {
            fbMsg.classList.add("hidden");
          }, 3000);
        }
      } catch (err) {
        fbMsg.textContent = "Error de conexión. Intentalo de nuevo.";
        fbMsg.className = "font-sans text-sm text-center text-triba-red mt-3";
      } finally {
        if (fbBtn) {
          fbBtn.disabled = false;
          fbBtn.textContent = "Enviar";
        }
        fbMsg.classList.remove("hidden");
      }
    });
  }

  // Banner dismiss
  document.querySelectorAll("[data-dismiss-banner]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const banner = btn.closest("[data-banner]") as HTMLElement | null;
      if (banner) banner.style.display = "none";
    });
  });

  }

  onPageCycle(setup);
</script>
