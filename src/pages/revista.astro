---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import { SITE_URL } from "../lib/site-url";
import MagazineCarousel from "../components/MagazineCarousel.astro";
import PDFViewer from "../components/PDFViewer.tsx";
import PatchTitle from "../components/PatchTitle.astro";

const title = "Revista";
const description = "Explorá las ediciones de Triba, nuestra revista digital mensual. Leé online, descargá PDF y descubrí artículos de cultura, arte e identidad.";
const canonical = "/revista";

import { getEditions, getFeaturedEdition } from "../lib/editions";
const allEditions = await getEditions();
const featuredEdition = await getFeaturedEdition();

const editions = allEditions.map((e, i) => ({
  id: e.id,
  edition: `#${e.edition_number}`,
  title: e.title,
  description: e.description,
  cover: e.cover_url,
  pdf: e.pdf_url ? `/api/pdf/${e.id}` : "#",
  featured: e.featured,
  badge: e.badge,
  previewArticle: e.edition_number === (featuredEdition?.edition_number || 3),
  flipColor: ["bg-triba-pink/80", "bg-triba-blue/80", "bg-triba-red/80"][i % 3],
  backTextClass: ["text-triba-brown", "text-triba-white", "text-triba-brown"][i % 3],
}));

const featured = editions.find((e) => e.featured) || editions[0];
---

<Layout title={title} description={description} canonical={canonical} navLogoAlways>
  <style>
    .edition-ribbon {
      position: absolute;
      top: 0;
      right: 0;
      z-index: 20;
      width: clamp(100px, 30vw, 150px);
      height: clamp(100px, 30vw, 150px);
      background: #E91A39;
      clip-path: polygon(100% 0, 0 0, 100% 100%);
      overflow: hidden;
    }
    .edition-ribbon span {
      position: absolute;
      top: 40%;
      left: 60%;
      transform: translate(-50%, -50%) rotate(45deg);
      color: white;
      font-family: 'Montserrat', sans-serif;
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      text-align: center;
      white-space: nowrap;
      text-shadow: 0 1px 2px rgba(0,0,0,0.3);
    }
  </style>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Periodical",
    "name": "Triba",
    "description": description,
    "url": `${SITE_URL}/revista`,
    "issn": "",
    "publisher": {
      "@type": "Organization",
      "name": "Triba",
      "url": SITE_URL
    },
    "inLanguage": "es",
    "numberOfIssues": allEditions.length,
  })} />
  <section class="py-12 md:py-24 px-5 md:px-10 lg:px-20 xl:px-32 2xl:px-48 bg-triba-bone" style="padding-top: max(1rem, var(--nav-height, 64px))">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-col gap-3 mb-8 pt-8 md:pt-12 reveal-text" data-reveal>
        <PatchTitle content="Nuestra revista" tag="h1" class="text-4xl md:text-5xl text-triba-brown" />
      </div>

      <!-- Bloque 1: Edición destacada — dos columnas -->
      <div class="flex flex-col md:flex-row gap-8 md:gap-12 mb-8 md:mb-20 reveal-stagger" data-reveal>
        <!-- Columna izquierda: texto -->
        <div class="flex-1 flex flex-col justify-center text-center md:text-left order-2 md:order-1">
          <p class="font-sans text-base text-triba-brown leading-relaxed mb-4">
            Todos los meses publicamos una nueva edición de nuestra revista, hecha por y para mujeres. Estamos felices de compartir con ustedes la tercer edición!
          </p>
          <p class="font-sans text-base text-triba-brown leading-relaxed mb-4">
            Con la participación de las colaboradoras fundadoras y algunas Triba Creators que se suman este mes. "El show debe continuar" viene a recordarnos un poco quienes fuimos y quienes somos hoy, transitando por 15 artículos diferentes pero igual de inspiradores.
          </p>
          <p class="font-sans text-base text-triba-brown leading-relaxed mb-8">
            Esperamos que disfrutes tu lectura, nos vemos el mes que viene.
          </p>
          <div class="flex justify-center md:justify-start">
            <Button variant="default" id="featured-cta" href="/suscribirme" class="px-10 py-4 text-base">
              LA QUIERO!
            </Button>
          </div>
        </div>
        <!-- Columna derecha: portada -->
        <div class="flex-1 flex items-center justify-center relative order-1 md:order-2">
          <div class="relative w-full max-w-sm overflow-hidden rounded-xl">
            <img id="featured-cover" src={featured.cover} alt={`Portada de ${featured.title}`} fetchpriority="high" class="w-full rounded-xl border-2 border-triba-black shadow-lg hover:scale-[1.02] transition-transform duration-500" />
            <!-- Badge ribbon "Última edición" -->
            <div class="edition-ribbon absolute top-0 right-0 z-20">
              <span>Última edición</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Bloque 2: Carrusel de ediciones -->
      <div class="relative bg-white w-full px-5 md:px-10 lg:px-20 py-8 md:py-14 rounded-[20px] mx-auto mb-12 md:mb-20 reveal" data-reveal>
        <div class="max-w-6xl mx-auto">
          <MagazineCarousel editions={editions} selectedId={featured.id} />
        </div>
      </div>

      <!-- Bloque 3: Vista previa de artículo -->
      {featured.pdf !== "#" && (
      <div id="visor-revista" class="flex flex-col md:flex-row gap-8 md:gap-12 lg:gap-16 reveal-stagger" style="scroll-margin-top: calc(var(--nav-height, 64px) + 1rem)" data-reveal>
        <div class="flex-1 order-2 md:order-1">
          <PDFViewer pdfUrl="/articulo-gratis.pdf" client:visible />
        </div>
        <div class="flex-1 flex flex-col justify-center order-1 md:order-2 text-center md:text-left">
          <PatchTitle tag="h2" class="mb-4 text-2xl md:text-3xl" lines={[
            [
              { t: "¡ECHALE", bg: "bg-triba-cream", tx: "text-triba-black" },
              { t: "UN", bg: "bg-triba-white", tx: "text-triba-black" },
              { t: "VISTAZO", bg: "bg-triba-pink", tx: "text-triba-black" },
              { t: "A", bg: "bg-triba-blue/20", tx: "text-triba-black" },
              { t: "UNO", bg: "bg-triba-bone", tx: "text-triba-black" },
            ],
            [
              { t: "DE", bg: "bg-triba-light-cream", tx: "text-triba-black" },
              { t: "NUESTROS", bg: "bg-triba-cream", tx: "text-triba-black" },
              { t: "ARTICULOS", bg: "bg-triba-green", tx: "text-triba-black" },
              { t: "!", bg: "bg-triba-pink", tx: "text-triba-black" },
            ],
          ]} />
          <p class="font-sans text-base md:text-lg text-triba-brown leading-relaxed mb-6">
            Como sabemos que no se puede desear lo que no se conoce, queremos regalarte un artículo gratis de la última edición de nuestra revista.
          </p>
          <p class="font-sans text-base md:text-lg text-triba-brown leading-relaxed mb-8">
            Si disfrutas de tu lectura, te esperamos en la suscripción!
          </p>
          <div class="flex justify-center md:justify-start">
            <Button variant="primary" href="/suscribirme">Suscribirme</Button>
          </div>
        </div>
      </div>
      )}
    </div>
  </section>
</Layout>

<script>
  function setup() {
    var featuredCover = document.getElementById("featured-cover") as HTMLImageElement | null;
    var featuredCta = document.getElementById("featured-cta") as HTMLAnchorElement | null;
    var carousel = document.querySelector("[data-carousel]")!;

    var featuredEl = document.querySelector("[data-featured]") as HTMLElement | null;
    var currentId = featuredEl ? parseInt(featuredEl.dataset.editionId || "0") : 0;

    function readEdition(card: HTMLElement) {
      return {
        id: parseInt(card.dataset.editionId!),
        edition: card.dataset.editionName!,
        title: card.dataset.title!,
        description: card.dataset.description!,
        cover: card.dataset.cover!,
        pdf: card.dataset.pdf!,
        badge: card.dataset.badge || null,
      };
    }

    function setActiveCard(id: number) {
      if (!carousel) return;
      var cards = carousel.querySelectorAll<HTMLElement>("[data-edition-id]");
      for (var i = 0; i < cards.length; i++) {
        var cardId = parseInt(cards[i].dataset.editionId!);
        var isSelected = cardId === id;
        cards[i].setAttribute("aria-selected", String(isSelected));
      }
    }

    function selectEdition(id: number) {
      if (id === currentId) return;
      var card = carousel.querySelector<HTMLElement>('[data-edition-id="' + id + '"]');
      if (!card) return;
      var ed = readEdition(card);
      currentId = id;

      if (featuredCover) {
        featuredCover.src = ed.cover;
        featuredCover.alt = "Portada de " + ed.title;
      }
      if (featuredCta) {
        featuredCta.href = "/suscribirme";
      }

      setActiveCard(id);
    }

    if (carousel) {
      carousel.addEventListener("click", function (e) {
        var target = e.target as HTMLElement | null;
        var card = target ? target.closest<HTMLElement>("[data-edition-id]") : null;
        if (card) {
          var id = parseInt(card.dataset.editionId!);
          selectEdition(id);
        }
      });
    }
  }

  setup();
  document.addEventListener("astro:page-load", setup);
</script>
