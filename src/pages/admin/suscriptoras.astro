---
import AdminLayout from "../../components/admin/AdminLayout.astro";
---

<AdminLayout title="Suscriptoras" active="suscriptoras">
  <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 mb-6">
    <div class="bg-triba-green/30 rounded-xl border-2 border-triba-black p-4">
      <p class="font-heading text-xs uppercase tracking-wider text-triba-brown/80">Activas</p>
      <p class="font-heading text-2xl text-triba-brown" id="stat-active">—</p>
    </div>
    <div class="bg-triba-cream rounded-xl border-2 border-triba-black p-4">
      <p class="font-heading text-xs uppercase tracking-wider text-triba-brown/80">Canceladas</p>
      <p class="font-heading text-2xl text-triba-brown" id="stat-canceled">—</p>
    </div>
    <div class="bg-triba-bone rounded-xl border-2 border-triba-black p-4">
      <p class="font-heading text-xs uppercase tracking-wider text-triba-brown/80">Sin sub</p>
      <p class="font-heading text-2xl text-triba-brown" id="stat-nosub">—</p>
    </div>
    <div class="bg-triba-pink rounded-xl border-2 border-triba-black p-4">
      <p class="font-heading text-xs uppercase tracking-wider text-triba-brown/80">Pend. registro</p>
      <p class="font-heading text-2xl text-triba-brown" id="stat-pending">—</p>
    </div>
    <div class="bg-triba-red/20 rounded-xl border-2 border-triba-black p-4">
      <p class="font-heading text-xs uppercase tracking-wider text-triba-brown/80">Reembolsadas</p>
      <p class="font-heading text-2xl text-triba-brown" id="stat-refunded">—</p>
    </div>
  </div>

  <details class="mb-6 bg-triba-cream rounded-xl border-2 border-triba-black p-4">
    <summary class="font-heading text-xs uppercase tracking-wider text-triba-brown cursor-pointer select-none">Migrar suscriptora desde WooCommerce</summary>
    <div class="mt-4 flex flex-col sm:flex-row gap-3">
      <input
        id="migrate-email"
        type="email"
        placeholder="email de la suscriptora"
        class="flex-1 px-4 py-2.5 rounded-button border-2 border-triba-black/20 bg-triba-white font-sans text-sm text-triba-brown outline-none focus:border-triba-red transition-colors"
      />
      <button id="migrate-btn" type="button" class="rounded-button bg-triba-green text-triba-brown border-2 border-triba-black px-5 py-2.5 font-heading text-xs uppercase tracking-wider hover:scale-[1.02] transition-all shrink-0">Migrar</button>
    </div>
    <p id="migrate-msg" class="font-sans text-sm hidden mt-3"></p>
  </details>

  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 mb-4">
    <div class="flex gap-2 flex-wrap">
      {[
        { key: "all", label: "Todas" },
        { key: "active", label: "Activas" },
        { key: "canceled", label: "Canceladas" },
        { key: "none", label: "Sin sub" },
        { key: "pending", label: "Pend. registro" },
        { key: "refunded", label: "Reembolsadas" },
      ].map((tab) => (
        <button
          class="sub-filter-btn rounded-button border-2 px-4 py-1.5 font-heading text-xs uppercase tracking-wider transition-all"
          data-filter={tab.key}
        >
          {tab.label}
        </button>
      ))}
    </div>
    <div class="flex gap-2 w-full sm:w-auto">
      <input
        id="sub-search"
        type="search"
        placeholder="Buscar por email…"
        class="flex-1 sm:w-64 px-4 py-2 rounded-button border-2 border-triba-black/20 bg-triba-white font-sans text-sm text-triba-brown outline-none focus:border-triba-red transition-colors"
      />
      <button id="sub-export" class="rounded-button bg-triba-bone text-triba-brown border-2 border-triba-black px-4 py-2 font-heading text-xs uppercase tracking-wider hover:scale-[1.02] transition-all shrink-0" title="Exportar CSV">⬇</button>
    </div>
  </div>

  <div id="subscribers-table-wrapper" class="bg-triba-white rounded-xl border-2 border-triba-black overflow-x-auto">
    <table class="w-full font-sans text-sm">
      <thead class="bg-triba-bone border-b-2 border-triba-black">
        <tr>
          <th class="text-left px-4 py-3 font-heading text-xs uppercase tracking-wider">Email</th>
          <th class="text-left px-4 py-3 font-heading text-xs uppercase tracking-wider">Provider</th>
          <th class="text-left px-4 py-3 font-heading text-xs uppercase tracking-wider">Plan</th>
          <th class="text-left px-4 py-3 font-heading text-xs uppercase tracking-wider">Estado</th>
          <th class="text-left px-4 py-3 font-heading text-xs uppercase tracking-wider hidden md:table-cell">Vence</th>
          <th class="text-right px-4 py-3 font-heading text-xs uppercase tracking-wider">Acciones</th>
        </tr>
      </thead>
      <tbody id="subscribers-tbody">
        <tr><td colspan="6" class="px-4 py-8 text-center text-triba-brown/50 font-sans text-sm">Cargando…</td></tr>
      </tbody>
    </table>
  </div>

  <div id="sub-pagination" class="flex items-center justify-between mt-4 gap-3 flex-wrap">
    <p id="sub-info" class="font-sans text-xs text-triba-brown/60"></p>
    <div class="flex gap-2">
      <button id="sub-prev" class="rounded-button border-2 border-triba-black/20 bg-triba-white text-triba-brown px-4 py-1.5 font-heading text-xs uppercase tracking-wider disabled:opacity-30 disabled:cursor-not-allowed hover:border-triba-black transition-all" disabled>Anterior</button>
      <button id="sub-next" class="rounded-button border-2 border-triba-black/20 bg-triba-white text-triba-brown px-4 py-1.5 font-heading text-xs uppercase tracking-wider disabled:opacity-30 disabled:cursor-not-allowed hover:border-triba-black transition-all" disabled>Siguiente</button>
    </div>
  </div>
</AdminLayout>

<script>
  import { escapeHtml } from "../../lib/escape";
  import { onPageCycle } from "../../lib/onPageCycle";
  let currentPage = 1;
  let currentFilter = "all";
  let currentSearch = "";
  let currentTotal = 0;
  let currentTotalPages = 0;

  const tbody = document.getElementById("subscribers-tbody")!;
  const searchInput = document.getElementById("sub-search") as HTMLInputElement;
  const prevBtn = document.getElementById("sub-prev") as HTMLButtonElement;
  const nextBtn = document.getElementById("sub-next") as HTMLButtonElement;
  const infoEl = document.getElementById("sub-info")!;
  const statActive = document.getElementById("stat-active")!;
  const statCanceled = document.getElementById("stat-canceled")!;
  const statNosub = document.getElementById("stat-nosub")!;
  const statPending = document.getElementById("stat-pending")!;
  const statRefunded = document.getElementById("stat-refunded")!;

  let searchTimer: ReturnType<typeof setTimeout> | null = null;

  async function loadSubscribers() {
    const params = new URLSearchParams();
    params.set("page", String(currentPage));
    params.set("status", currentFilter);
    params.set("pageSize", "20");
    if (currentSearch) params.set("search", currentSearch);

    try {
      const res = await fetch(`/api/admin/subscribers?${params}`);
      const data = await res.json();
      if (!res.ok) return;

      const { rows, total, page, totalPages } = data;
      currentTotal = total;
      currentTotalPages = totalPages;

      if (typeof data.totalPending === "number") {
        statPending.textContent = String(data.totalPending);
      }
      if (typeof data.totalRefunded === "number") {
        statRefunded.textContent = String(data.totalRefunded);
      }
      if (currentFilter === "pending" || currentFilter === "refunded") {
        statActive.textContent = "—";
        statCanceled.textContent = "—";
        statNosub.textContent = "—";
      } else {
        if (typeof data.totalActive === "number") statActive.textContent = String(data.totalActive);
        if (typeof data.totalCanceled === "number") statCanceled.textContent = String(data.totalCanceled);
        if (typeof data.totalNone === "number") statNosub.textContent = String(data.totalNone);
      }

      if (rows.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" class="px-4 py-8 text-center text-triba-brown/50 font-sans text-sm">No se encontraron suscriptoras.</td></tr>`;
      } else {
        tbody.innerHTML = rows.map((row: any) => {
          if (row.migrationId) {
            const email = row.migrationEmail || "";
            const isRefunded = row.migrationRefunded;
            const stripeStatus = row.migrationStripeStatus;
            const hasStripeSub = !!row.migrationStripeSubId;
            const hasMpSub = !!row.migrationMpPreapprovalId;
            const mpCurrency = row.migrationMpCurrency || "";

            let statusLabel: string;
            let statusClass: string;
            if (isRefunded) {
              statusLabel = "Reembolsada";
              statusClass = "bg-triba-red/20 text-triba-red";
            } else if (stripeStatus === "active") {
              statusLabel = "Sub activa";
              statusClass = "bg-triba-green text-triba-brown";
            } else if (stripeStatus === "incomplete") {
              statusLabel = "Sub incompleta";
              statusClass = "bg-triba-cream text-triba-brown";
            } else if (stripeStatus === "canceled") {
              statusLabel = "Sub cancelada";
              statusClass = "bg-triba-bone text-triba-brown/60";
            } else if (hasStripeSub) {
              statusLabel = "Con Stripe";
              statusClass = "bg-triba-pink text-triba-brown";
            } else if (hasMpSub) {
              statusLabel = "MP activa";
              statusClass = "bg-triba-green text-triba-brown";
            } else {
              statusLabel = "Sin billing";
              statusClass = "bg-triba-bone text-triba-brown/60";
            }

            const provider = hasStripeSub ? "Stripe" : hasMpSub ? "Mercado Pago" : "CSV";
            const plan = hasMpSub ? mpCurrency : "—";
            const canAct = hasStripeSub && !isRefunded && stripeStatus === "active";
            const refundBtn = canAct
              ? `<button class="refund-btn font-sans text-xs text-triba-red hover:underline min-h-[44px] min-w-[44px] flex items-center justify-center" data-migration-id="${row.migrationId}" data-user-id="${row.migrationId || row.profile?.id || ""}" data-email="${escapeHtml(email)}">Reembolsar</button>`
              : "";
            const cancelBtn = canAct
              ? `<button class="cancel-btn font-sans text-xs text-triba-red hover:underline min-h-[44px] min-w-[44px] flex items-center justify-center" data-migration-id="${row.migrationId}" data-email="${escapeHtml(email)}">Cancelar</button>`
              : "";
            const actionsContent = [refundBtn, cancelBtn].filter(Boolean).join('<span class="text-triba-brown/20 mx-1">|</span>') || "—";

            return `<tr class="border-b border-triba-black/10 last:border-0 hover:bg-triba-bone/50">
              <td class="px-4 py-3"><p class="font-sans">${escapeHtml(email)}</p><p class="font-sans text-xs text-triba-brown/60">pend. registro</p></td>
              <td class="px-4 py-3 capitalize">${provider}</td>
              <td class="px-4 py-3">${plan}</td>
              <td class="px-4 py-3"><span class="inline-block px-2 py-0.5 rounded-full ${statusClass} font-heading text-[10px] uppercase tracking-wider">${statusLabel}</span></td>
              <td class="px-4 py-3 text-triba-brown/70 hidden md:table-cell">—</td>
              <td class="px-4 py-3 text-right"><div class="flex items-center justify-end gap-1">${actionsContent}</div></td>
            </tr>`;
          }

          const s = row.subscription;
          const statusClass = s?.status === "active"
            ? "bg-triba-green text-triba-brown"
            : s?.status === "canceled"
              ? "bg-triba-bone text-triba-brown/60"
              : "";
          const statusLabel = s?.status === "active" ? "Activa" : s?.status === "canceled" ? "Cancelada" : "—";
          const periodEnd = s?.current_period_end
            ? new Date(s.current_period_end).toLocaleDateString("es-AR", { day: "2-digit", month: "short", year: "numeric" })
            : "—";
          const canRefund = s?.status === "active" && (s?.provider === "stripe" || s?.provider === "mercadopago");
          const canCancel = s?.status === "active";
          const cancelBtn = canCancel
            ? `<button class="cancel-btn font-sans text-xs text-triba-red hover:underline min-h-[44px] min-w-[44px] flex items-center justify-center" data-user-id="${row.profile.id}" data-email="${row.profile.email}">Cancelar</button>`
            : "";
          const refundBtn = canRefund
              ? `<button class="refund-btn font-sans text-xs text-triba-red hover:underline min-h-[44px] min-w-[44px] flex items-center justify-center" data-user-id="${row.profile.id}" data-migration-id="" data-email="${row.profile.email}">Reembolsar</button>`
              : "";
          const actionsContent = [cancelBtn, refundBtn].filter(Boolean).join('<span class="text-triba-brown/20 mx-1">|</span>') || "—";
          return `<tr class="border-b border-triba-black/10 last:border-0 hover:bg-triba-bone/50">
            <td class="px-4 py-3"><p class="font-sans">${escapeHtml(row.profile.email)}</p><p class="font-sans text-xs text-triba-brown/60">${row.profile.role}</p></td>
            <td class="px-4 py-3 capitalize">${s?.provider || "—"}</td>
            <td class="px-4 py-3">${s?.plan_currency || "—"}</td>
            <td class="px-4 py-3">${statusLabel !== "—" ? `<span class="inline-block px-2 py-0.5 rounded-full ${statusClass} font-heading text-[10px] uppercase tracking-wider">${statusLabel}</span>` : statusLabel}</td>
            <td class="px-4 py-3 text-triba-brown/70 hidden md:table-cell">${periodEnd}</td>
            <td class="px-4 py-3 text-right">
              <div class="flex items-center justify-end gap-1">
                ${actionsContent}
              </div>
            </td>
          </tr>`;
        }).join("");
      }

      infoEl.textContent = `Página ${page} de ${totalPages} (${total} total)`;
      prevBtn.disabled = page <= 1;
      nextBtn.disabled = page >= totalPages;

      bindCancelButtons();
      bindRefundButtons();
    } catch {
      tbody.innerHTML = `<tr><td colspan="6" class="px-4 py-8 text-center text-triba-red/70 font-sans text-sm">Error al cargar</td></tr>`;
    }
  }

  function bindCancelButtons() {
    document.querySelectorAll<HTMLButtonElement>(".cancel-btn").forEach((btn) => {
      if (btn.dataset.bound === "1") return;
      btn.dataset.bound = "1";
      btn.addEventListener("click", async () => {
        const userId = btn.dataset.userId;
        const migrationId = btn.dataset.migrationId;
        const id = userId || migrationId;
        const email = btn.dataset.email!;
        const confirmed = await (window as any).adminConfirm?.(
          "Cancelar suscripción",
          `¿Cancelar la suscripción de ${email}? Esto también resetea su role a 'free'.`
        );
        if (!confirmed) return;
        btn.disabled = true;
        const original = btn.textContent;
        btn.textContent = "Cancelando...";
        try {
          const res = await fetch(`/api/admin/subscribers/${id}/cancel`, { method: "POST" });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) {
            (window as any).adminToast?.(data.error || "Error cancelando", "error");
            btn.disabled = false;
            btn.textContent = original;
            return;
          }
          (window as any).adminToast?.("Suscripción cancelada", "success");
          if (data.providerWarnings && data.providerWarnings.length > 0) {
            const warnMsg = "Cancelada en la app, pero hubo un problema con el proveedor de pago: " + data.providerWarnings.join(". ");
            (window as any).adminToast?.(warnMsg, "warning");
          }
          loadSubscribers();
        } catch {
          (window as any).adminToast?.("Error de conexión", "error");
          btn.disabled = false;
          btn.textContent = original;
        }
      });
    });
  }

  function bindRefundButtons() {
    document.querySelectorAll<HTMLButtonElement>(".refund-btn").forEach((btn) => {
      if (btn.dataset.bound === "1") return;
      btn.dataset.bound = "1";
      btn.addEventListener("click", async () => {
        const userId = btn.dataset.userId;
        const migrationId = btn.dataset.migrationId;
        const id = userId || migrationId;
        const email = btn.dataset.email!;
        const confirmed = await (window as any).adminConfirm?.(
          "Reembolsar y Cancelar",
          `¿Reembolsar el último cobro de ${email} y cancelar su suscripción? Esto no se puede deshacer.`
        );
        if (!confirmed) return;
        btn.disabled = true;
        const original = btn.textContent;
        btn.textContent = "Reembolsando...";
        try {
          const res = await fetch(`/api/admin/subscribers/${id}/refund`, { method: "POST" });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) {
            (window as any).adminToast?.(data.error || "Error al reembolsar", "error");
            btn.disabled = false;
            btn.textContent = original;
            return;
          }
          if (data.warnings && data.warnings.length > 0) {
            (window as any).adminToast?.(`Reembolso OK con advertencias: ${data.warnings.join(", ")}`, "warning");
          } else {
            (window as any).adminToast?.("Reembolso procesado correctamente", "success");
          }
          loadSubscribers();
        } catch {
          (window as any).adminToast?.("Error de conexión", "error");
          btn.disabled = false;
          btn.textContent = original;
        }
      });
    });
  }

  function setupMigrate() {
    const btn = document.getElementById("migrate-btn") as HTMLButtonElement | null;
    const input = document.getElementById("migrate-email") as HTMLInputElement | null;
    const msg = document.getElementById("migrate-msg");
    if (!btn || !input || !msg) return;

    btn.addEventListener("click", async () => {
      const email = input.value.trim();
      if (!email || !email.includes("@")) {
        msg.textContent = "Ingresá un email válido";
        msg.className = "font-sans text-sm text-triba-red bg-triba-red/10 border border-triba-red rounded p-3";
        msg.classList.remove("hidden");
        return;
      }

      const confirmed = await (window as any).adminConfirm?.(
        "Migrar suscriptora",
        `¿Migrar ${email}? Se registrará en subscriber_migrations y, si ya tiene cuenta, se le asignará role subscriber con 7 días de acceso.`
      );
      if (!confirmed) return;

      btn.disabled = true;
      btn.textContent = "Migrando...";

      try {
        const res = await fetch("/api/admin/subscribers/migrate", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email }),
        });
        const data = await res.json();

        if (!res.ok) {
          msg.textContent = data.error || "Error";
          msg.className = "font-sans text-sm text-triba-red bg-triba-red/10 border border-triba-red rounded p-3";
          msg.classList.remove("hidden");
          (window as any).adminToast?.(data.error || "Error", "error");
          return;
        }

        msg.textContent = data.note;
        msg.className = "font-sans text-sm text-triba-green bg-triba-green/10 border border-triba-green rounded p-3";
        msg.classList.remove("hidden");
        (window as any).adminToast?.(data.alreadyMigrated ? "Ya estaba migrada" : "Migrada correctamente", "success");
        input.value = "";
        loadSubscribers();
      } catch {
        msg.textContent = "Error de conexión";
        msg.className = "font-sans text-sm text-triba-red bg-triba-red/10 border border-triba-red rounded p-3";
        msg.classList.remove("hidden");
        (window as any).adminToast?.("Error de conexión", "error");
      } finally {
        btn.disabled = false;
        btn.textContent = "Migrar";
      }
    });
  }

  function initSubscribers() {
    setupMigrate();
    searchInput.addEventListener("input", () => {
      if (searchTimer) clearTimeout(searchTimer);
      searchTimer = setTimeout(() => {
        currentSearch = searchInput.value.trim();
        currentPage = 1;
        loadSubscribers();
      }, 300);
    });

    document.querySelectorAll<HTMLButtonElement>(".sub-filter-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".sub-filter-btn").forEach((b) => {
          b.className = b.className.replace(/bg-triba-red text-triba-white border-triba-black/g, "bg-triba-white text-triba-brown border-triba-black/20");
        });
        btn.className = btn.className.replace(/bg-triba-white text-triba-brown border-triba-black\/20/g, "bg-triba-red text-triba-white border-triba-black");
        currentFilter = btn.dataset.filter!;
        currentPage = 1;
        loadSubscribers();
      });
    });

    document.getElementById("sub-export")!.addEventListener("click", () => {
      const params = new URLSearchParams();
      params.set("status", currentFilter);
      if (currentSearch) params.set("search", currentSearch);
      window.open(`/api/admin/subscribers/export?${params}`, "_blank");
    });

    prevBtn.addEventListener("click", () => {
      if (currentPage > 1) { currentPage--; loadSubscribers(); }
    });
    nextBtn.addEventListener("click", () => {
      if (currentPage < currentTotalPages) { currentPage++; loadSubscribers(); }
    });

    document.querySelector<HTMLButtonElement>('.sub-filter-btn[data-filter="all"]')?.classList.add("bg-triba-red", "text-triba-white", "border-triba-black");

    loadSubscribers();
  }

  onPageCycle(initSubscribers);
</script>
