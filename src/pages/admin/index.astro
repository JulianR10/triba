---
import AdminLayout from "../../components/admin/AdminLayout.astro";
import { getAdminDashboardStats } from "../../lib/admin";

const stats = await getAdminDashboardStats();

const cards = [
  {
    label: "Suscriptoras activas",
    value: stats.active_subscribers,
    href: "/admin/suscriptoras",
    color: "bg-triba-green/30",
  },
  {
    label: "Mail Club activas",
    value: stats.active_mail_club,
    sub: `${stats.active_digital} digital`,
    href: "/admin/suscriptoras",
    color: "bg-triba-pink",
  },
  {
    label: "Pagos pendientes",
    value: stats.pending_payment,
    sub: stats.pending_payment > 0 ? "revisar en reconcile" : undefined,
    href: "/admin/suscriptoras",
    color: stats.pending_payment > 0 ? "bg-triba-red/10" : "bg-triba-bone",
  },
  {
    label: "Suscriptoras migradas",
    value: stats.migrated_subscribers,
    href: "/admin/suscriptoras",
    color: "bg-triba-pink",
  },
  {
    label: "Ediciones totales",
    value: stats.editions_total,
    sub: stats.editions_featured === 1 ? "1 destacada" : `${stats.editions_featured} destacadas`,
    href: "/admin/ediciones",
    color: "bg-triba-light-cream",
  },
  {
    label: "Feedback recibido",
    value: stats.feedback_count,
    href: "/admin/feedback",
    color: "bg-triba-cream",
  },
  {
    label: "Creators pendientes",
    value: stats.creators_pending,
    href: "/admin/creators",
    color: "bg-triba-light-cream",
  },
  {
    label: "Newsletter",
    value: stats.newsletter_count,
    sub: stats.newsletter_pending_sync > 0 ? `${stats.newsletter_pending_sync} pendiente${stats.newsletter_pending_sync === 1 ? "" : "s"} de sync` : undefined,
    color: stats.newsletter_pending_sync > 0 ? "bg-triba-red/10" : "bg-triba-bone",
  },
  {
    label: "Suscripciones canceladas",
    value: stats.canceled_subscribers,
    href: "/admin/suscriptoras",
    color: "bg-triba-bone",
  },
];
---

<AdminLayout title="Dashboard" active="dashboard">
  <p class="font-sans text-base text-triba-brown/70 mb-6">
    Accesos rápidos para operar Triba: crear una edición, ver suscriptoras, responder creators.
  </p>
  <div id="admin-alerts" class="space-y-3 mb-6"></div>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
    {
      cards.map((card) => {
        const inner = (
          <div class={`${card.color} rounded-xl border-2 border-triba-black p-5 transition-all hover:scale-[1.02] h-full`}>
            <p class="font-heading text-xs uppercase tracking-wider text-triba-brown/80 mb-1">{card.label}</p>
            <p class="font-heading text-3xl text-triba-brown">{card.value}</p>
            {card.sub && <p class="font-sans text-xs text-triba-brown/60 mt-1">{card.sub}</p>}
          </div>
        );
        return card.href ? (
          <a href={card.href}>{inner}</a>
        ) : (
          inner
        );
      })
    }
  </div>

  {stats.newsletter_pending_sync > 0 && (
    <div class="mb-6 p-4 bg-triba-red/10 border-2 border-triba-red rounded-xl">
      <p class="font-heading text-xs uppercase tracking-wider text-triba-red mb-1">Newsletter — sync pendiente</p>
      <p class="font-sans text-sm text-triba-brown/80">Hay {stats.newsletter_pending_sync} suscripción{stats.newsletter_pending_sync === 1 ? "" : "es"} sin welcome en Sender (429 previo). Ejecutá <code class="bg-triba-white px-1 rounded">node --env-file=.env scripts/resync-newsletters.mjs</code> o reintentá desde el flujo 23505.</p>
    </div>
  )}

  <div class="bg-triba-white rounded-xl border-2 border-triba-black p-6">
    <h2 class="font-heading text-base uppercase tracking-wider text-triba-brown mb-3">Acciones rápidas</h2>
    <div class="flex flex-wrap gap-3">
      <a href="/admin/ediciones/nuevo" class="rounded-button bg-triba-red text-triba-white border-2 border-triba-black px-5 py-2.5 font-heading text-xs uppercase tracking-wider hover:scale-[1.02] transition-all">+ Nueva edición</a>
      <a href="/admin/creators?status=pending" class="rounded-button bg-triba-bone text-triba-brown border-2 border-triba-black px-5 py-2.5 font-heading text-xs uppercase tracking-wider hover:scale-[1.02] transition-all">Revisar creators</a>
      <a href="/admin/mail-club" class="rounded-button bg-triba-green text-triba-brown border-2 border-triba-black px-5 py-2.5 font-heading text-xs uppercase tracking-wider hover:scale-[1.02] transition-all">Mail Club</a>
    </div>
  </div>
</AdminLayout>

<script>
  import { onPageCycle } from "../../lib/onPageCycle";

  // Alertas accionables: solo aparecen si hay algo que atender. Liviano:
  // 2 fetches a endpoints de conteo/listas acotadas + fecha Madrid local.
  async function initAlerts() {
    const box = document.getElementById("admin-alerts");
    if (!box || box.dataset.done === "1") return;
    box.dataset.done = "1";

    const alerts: { href: string; text: string; urgent: boolean }[] = [];
    try {
      const [rec, att] = await Promise.all([
        fetch("/api/admin/subscribers/reconcile").then((r) => r.json().catch(() => ({}))),
        fetch("/api/admin/mail-club/attention").then((r) => r.json().catch(() => ({}))),
      ]);
      const candidates = (rec.candidates || []) as unknown[];
      const skipped = (rec.skipped || []) as { email?: string }[];
      if (candidates.length > 0) {
        alerts.push({ href: "/admin/suscriptoras", text: `${candidates.length} pago(s) confirmado(s) sin activar →`, urgent: true });
      } else if (skipped.length > 0) {
        alerts.push({ href: "/admin/suscriptoras", text: `${skipped.length} pago(s) pendiente(s) de cobro`, urgent: false });
      }
      const noAddr = (att.withoutAddress || []) as unknown[];
      if (noAddr.length > 0) {
        alerts.push({ href: "/admin/mail-club", text: `${noAddr.length} activa(s) Mail Club sin dirección (quedan fuera del lote) →`, urgent: true });
      }
      const notices = (att.pendingNotices || []) as { pending_emails?: unknown[] }[];
      const pendingCount = notices.reduce((n, x) => n + ((x.pending_emails || []) as unknown[]).length, 0);
      if (pendingCount > 0) {
        alerts.push({ href: "/admin/mail-club", text: `${pendingCount} aviso(s) de despacho sin enviar →`, urgent: false });
      }
    } catch { /* sin alertas si falla la red */ }

    try {
      const parts = new Intl.DateTimeFormat("en-CA", {
        timeZone: "Europe/Madrid", year: "numeric", month: "2-digit", day: "2-digit",
      }).formatToParts(new Date());
      const get = (t: string) => Number(parts.find((p) => p.type === t)?.value || 0);
      const day = get("day");
      if (day <= 13) {
        alerts.push({ href: "/admin/mail-club", text: `Corte Mail Club en ${15 - day} día(s) (día 15, hora Madrid)`, urgent: false });
      } else if (day <= 15) {
        alerts.push({ href: "/admin/mail-club", text: `¡Corte Mail Club en ${15 - day} día(s)! Revisá pendientes`, urgent: true });
      } else if (day <= 20) {
        alerts.push({ href: "/admin/mail-club", text: `Despacho el 20 (en ${20 - day} día(s))`, urgent: false });
      }
    } catch { /* fecha siempre disponible en la práctica */ }

    if (alerts.length === 0) {
      box.innerHTML = `<div class="p-4 bg-triba-green/20 border-2 border-triba-black rounded-xl"><p class="font-sans text-sm text-triba-brown">Todo al día — sin pendientes.</p></div>`;
      return;
    }
    box.innerHTML = alerts.map((a) => `
      <a href="${a.href}" class="block p-4 ${a.urgent ? "bg-triba-red/10 border-triba-red" : "bg-triba-cream border-triba-black"} border-2 rounded-xl hover:scale-[1.01] transition-all">
        <p class="font-sans text-sm text-triba-brown">${a.text}</p>
      </a>`).join("");
  }

  onPageCycle(initAlerts);
</script>
