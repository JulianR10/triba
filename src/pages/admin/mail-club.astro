---
import AdminLayout from "../../components/admin/AdminLayout.astro";
---

<AdminLayout title="Mail Club" active="mail-club">
  <div id="mc-ops" class="bg-triba-white rounded-xl border-2 border-triba-black p-4 mb-4"></div>
  <div id="mc-attention"></div>
  <p class="font-sans text-xs text-triba-brown/70 mb-4">
    Origen: Madrid · Corte día 15 inclusive (hora España) · Despacho día 20.
    El lote congela las direcciones al corte; los cambios posteriores van al mes siguiente.
  </p>

  <div class="bg-triba-white rounded-xl border-2 border-triba-black p-4 mb-4">
    <h2 class="font-heading text-xs uppercase tracking-wider text-triba-brown mb-3">Crear / cargar lote mensual</h2>
    <div class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-end">
      <label class="block">
        <span class="font-sans text-xs text-triba-brown/70">Año</span>
        <input id="mc-year" type="number" min="2026" max="2100"
          class="mt-1 w-full sm:w-32 px-4 py-2.5 rounded-button border-2 border-triba-black/20 bg-triba-white font-sans text-sm text-triba-brown outline-none focus:border-triba-red transition-colors" />
      </label>
      <label class="block">
        <span class="font-sans text-xs text-triba-brown/70">Mes</span>
        <input id="mc-month" type="number" min="1" max="12"
          class="mt-1 w-full sm:w-28 px-4 py-2.5 rounded-button border-2 border-triba-black/20 bg-triba-white font-sans text-sm text-triba-brown outline-none focus:border-triba-red transition-colors" />
      </label>
      <button id="mc-create" type="button" class="rounded-button bg-triba-green text-triba-brown border-2 border-triba-black px-5 py-2.5 font-heading text-xs uppercase tracking-wider hover:scale-[1.02] transition-all shrink-0">Crear lote</button>
      <button id="mc-preview" type="button" class="rounded-button bg-triba-bone text-triba-brown border-2 border-triba-black px-5 py-2.5 font-heading text-xs uppercase tracking-wider hover:scale-[1.02] transition-all shrink-0">Simular</button>
    </div>
    <p id="mc-create-msg" class="font-sans text-sm hidden mt-3"></p>
  </div>

  <div class="bg-triba-white rounded-xl border-2 border-triba-black overflow-x-auto">
    <table class="w-full font-sans text-sm">
      <thead class="bg-triba-bone border-b-2 border-triba-black">
        <tr>
          <th class="text-left px-4 py-3 font-heading text-xs uppercase tracking-wider">Período</th>
          <th class="text-left px-4 py-3 font-heading text-xs uppercase tracking-wider">Corte</th>
          <th class="text-left px-4 py-3 font-heading text-xs uppercase tracking-wider">Destinatarias</th>
          <th class="text-left px-4 py-3 font-heading text-xs uppercase tracking-wider">Estado</th>
          <th class="text-right px-4 py-3 font-heading text-xs uppercase tracking-wider">Acciones</th>
        </tr>
      </thead>
      <tbody id="mc-tbody">
        <tr><td colspan="5" class="px-4 py-8 text-center text-triba-brown/50 font-sans text-sm">Cargando…</td></tr>
      </tbody>
    </table>
  </div>

  <div id="mc-result" class="hidden mt-6 bg-triba-cream rounded-xl border-2 border-triba-black p-5"></div>

  <details class="mt-6 bg-triba-white rounded-xl border-2 border-triba-black p-4">
    <summary class="font-heading text-xs uppercase tracking-wider text-triba-brown cursor-pointer select-none">Retención postal (60 días)</summary>
    <p class="font-sans text-xs text-triba-brown/70 mt-2 mb-3">Purga direcciones congeladas de lotes despachados hace más de 60 días y borra direcciones de usuarias sin Mail Club activo. Primero revisá, después aplicá.</p>
    <div class="flex flex-col sm:flex-row gap-3">
      <button id="mc-retention-check" type="button" class="rounded-button bg-triba-bone text-triba-brown border-2 border-triba-black px-5 py-2.5 font-heading text-xs uppercase tracking-wider hover:scale-[1.02] transition-all shrink-0">Revisar</button>
      <button id="mc-retention-apply" type="button" class="hidden rounded-button bg-triba-red text-triba-white border-2 border-triba-black px-5 py-2.5 font-heading text-xs uppercase tracking-wider hover:scale-[1.02] transition-all shrink-0">Aplicar purga</button>
    </div>
    <div id="mc-retention-result" class="mt-3 font-sans text-xs text-triba-brown/80"></div>
  </details>

  <div id="mc-detail" class="hidden mt-6 bg-triba-white rounded-xl border-2 border-triba-black overflow-x-auto"></div>
</AdminLayout>

<script>
  import { escapeHtml } from "../../lib/escape";
  import { onPageCycle } from "../../lib/onPageCycle";

  const STATUS_LABELS: Record<string, string> = {
    open: "Abierto",
    closed: "Cerrado",
    dispatched: "Despachado",
  };

  function showResult(html: string) {
    const box = document.getElementById("mc-result")!;
    box.innerHTML = html;
    box.classList.remove("hidden");
    box.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }

  function madridToday(): { year: number; month: number; day: number } {
    const parts = new Intl.DateTimeFormat("en-CA", {
      timeZone: "Europe/Madrid", year: "numeric", month: "2-digit", day: "2-digit",
    }).formatToParts(new Date());
    const get = (t: string) => Number(parts.find((p) => p.type === t)?.value || 0);
    return { year: get("year"), month: get("month"), day: get("day") };
  }

  function renderOps(batches: any[]) {
    const box = document.getElementById("mc-ops")!;
    const now = madridToday();
    const period = `${now.year}-${String(now.month).padStart(2, "0")}`;
    const batch = batches.find((b: any) => b.period_year === now.year && b.period_month === now.month);
    const step = (done: boolean, label: string) =>
      `<li class="flex items-center gap-2 font-sans text-xs ${done ? "text-triba-brown" : "text-triba-brown/50"}">
         <span class="inline-flex items-center justify-center w-5 h-5 rounded-full border-2 ${done ? "bg-triba-green border-triba-black" : "border-triba-black/20"} text-[10px]">${done ? "✓" : "·"}</span>${label}</li>`;
    let timing: string;
    if (now.day <= 15) {
      timing = `Corte en <strong>${15 - now.day}</strong> día(s) — las altas hasta el 15 entran al sobre de ${period}.`;
    } else if (now.day <= 20) {
      timing = `Corte cerrado — despacho el 20 (en <strong>${20 - now.day}</strong> día(s)). Los cambios de dirección ya van al mes siguiente.`;
    } else {
      timing = `Despacho en curso — las altas nuevas entran al sobre del mes siguiente.`;
    }
    box.innerHTML = `
      <p class="font-sans text-xs text-triba-brown/80 mb-2">${timing}</p>
      <ul class="space-y-1">
        ${step(!!batch, `Lote ${period} ${batch ? `creado (${batch.item_count} destinataria(s))` : "sin crear"}`)}
        ${step(batch?.status === "dispatched", `Despacho avisado ${batch?.status === "dispatched" ? "" : "(pendiente)"}`)}
      </ul>`;
  }

  async function loadAttention() {
    const box = document.getElementById("mc-attention")!;
    try {
      const res = await fetch("/api/admin/mail-club/attention");
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Error");
      const rows = data.withoutAddress || [];
      const notices = data.pendingNotices || [];
      if (rows.length === 0 && notices.length === 0) { box.innerHTML = ""; return; }
      let html = "";
      if (rows.length > 0) {
        html += `
        <div class="mb-4 p-4 bg-triba-red/10 border-2 border-triba-red rounded-xl">
          <p class="font-heading text-xs uppercase tracking-wider text-triba-red mb-1">Activas sin dirección (${rows.length})</p>
          <p class="font-sans text-xs text-triba-brown/80 mb-2">Pagan Mail Club pero quedarían fuera del lote en silencio. Avisales antes del corte.</p>
          <ul class="font-sans text-xs space-y-1">` +
            rows.map((r: any) => `<li><a class="hover:text-triba-red hover:underline" href="/admin/suscriptoras/${r.user_id}">${escapeHtml(r.email || "sin email")}</a></li>`).join("") +
          `</ul>
        </div>`;
      }
      if (notices.length > 0) {
        html += `
        <div class="mb-4 p-4 bg-triba-cream border-2 border-triba-black rounded-xl">
          <p class="font-heading text-xs uppercase tracking-wider text-triba-brown mb-1">Avisos de despacho pendientes</p>
          <ul class="space-y-2">` +
            notices.map((n: any) => `
              <li class="flex flex-wrap items-center gap-2 font-sans text-xs text-triba-brown/80">
                <span>Lote ${n.period_year}-${String(n.period_month).padStart(2, "0")}: <strong>${n.pending_emails.length}</strong> sin avisar</span>
                <button class="mc-retry-notice rounded-button bg-triba-bone text-triba-brown border-2 border-triba-black px-3 py-1.5 font-heading text-[11px] uppercase tracking-wider min-h-[44px]" data-batch="${n.batch_id}" data-emails="${escapeHtml((n.pending_emails || []).join(","))}">Reintentar</button>
              </li>`).join("") +
          `</ul>
        </div>`;
      }
      box.innerHTML = html;
      box.querySelectorAll<HTMLButtonElement>(".mc-retry-notice").forEach((b) => {
        b.addEventListener("click", async () => {
          const emails = (b.dataset.emails || "").split(",").map((e) => e.trim()).filter(Boolean);
          if (emails.length === 0) return;
          b.disabled = true;
          b.textContent = "Avisando...";
          try {
            const r2 = await fetch(`/api/admin/mail-club/batches/${b.dataset.batch}/dispatch`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ emails }),
            });
            const d2 = await r2.json().catch(() => ({}));
            if (!r2.ok) {
              (window as any).adminToast?.(d2.error || "Error reintentando", "error");
            } else {
              (window as any).adminToast?.(`${d2.sent} avisos enviados`, "success");
              loadAttention();
              loadBatches();
            }
          } catch {
            (window as any).adminToast?.("Error de conexión", "error");
          } finally {
            b.disabled = false;
            b.textContent = "Reintentar";
          }
        });
      });
    } catch {
      box.innerHTML = "";
    }
  }

  async function loadBatches() {
    const tbody = document.getElementById("mc-tbody")!;
    try {
      const res = await fetch("/api/admin/mail-club/batches");
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Error");
      const batches = data.batches || [];
      renderOps(batches);
      if (batches.length === 0) {
        tbody.innerHTML = `<tr><td colspan="5" class="px-4 py-8 text-center text-triba-brown/50 font-sans text-sm">Todavía no hay lotes. Creá el primero arriba.</td></tr>`;
        return;
      }
      tbody.innerHTML = batches.map((b: any) => {
        const period = `${b.period_year}-${String(b.period_month).padStart(2, "0")}`;
        const cutoff = new Date(b.cutoff_at).toLocaleString("es-AR", { day: "2-digit", month: "short", hour: "2-digit", minute: "2-digit" });
        const statusClass = b.status === "dispatched"
          ? "bg-triba-green text-triba-brown"
          : b.status === "closed"
            ? "bg-triba-cream text-triba-brown"
            : "bg-triba-bone text-triba-brown/60";
        return `<tr class="border-b border-triba-black/10 last:border-0 hover:bg-triba-bone/50">
          <td class="px-4 py-3 font-heading text-sm">${period}</td>
          <td class="px-4 py-3 text-triba-brown/70">${escapeHtml(cutoff)}</td>
          <td class="px-4 py-3">${b.item_count}</td>
          <td class="px-4 py-3"><span class="inline-block px-2 py-0.5 rounded-full ${statusClass} font-heading text-[10px] uppercase tracking-wider">${STATUS_LABELS[b.status] || b.status}</span></td>
          <td class="px-4 py-3 text-right whitespace-nowrap">
            <button class="mc-view font-sans text-xs text-triba-brown hover:text-triba-red hover:underline min-h-[44px] px-2" data-id="${b.id}" data-period="${period}">Ver</button>
            <span class="text-triba-brown/20 mx-1">|</span>
            <button class="mc-export font-sans text-xs text-triba-brown hover:text-triba-red hover:underline min-h-[44px] px-2" data-id="${b.id}">CSV ⬇</button>
            <span class="text-triba-brown/20 mx-1">|</span>
            <button class="mc-dispatch font-sans text-xs text-triba-red hover:underline min-h-[44px] px-2" data-id="${b.id}" data-period="${period}">Avisar despacho</button>
          </td>
        </tr>`;
      }).join("");
      bindRowButtons();
    } catch {
      tbody.innerHTML = `<tr><td colspan="5" class="px-4 py-8 text-center text-triba-red/70 font-sans text-sm">Error al cargar</td></tr>`;
      renderOps([]);
    }
  }

  function bindRowButtons() {
    document.querySelectorAll<HTMLButtonElement>(".mc-view").forEach((btn) => {
      if (btn.dataset.bound === "1") return;
      btn.dataset.bound = "1";
      btn.addEventListener("click", () => loadBatchDetail(btn.dataset.id || "", btn.dataset.period || ""));
    });
    document.querySelectorAll<HTMLButtonElement>(".mc-export").forEach((btn) => {
      if (btn.dataset.bound === "1") return;
      btn.dataset.bound = "1";
      btn.addEventListener("click", () => {
        window.open(`/api/admin/mail-club/batches/${btn.dataset.id}/export`, "_blank");
      });
    });
    document.querySelectorAll<HTMLButtonElement>(".mc-dispatch").forEach((btn) => {
      if (btn.dataset.bound === "1") return;
      btn.dataset.bound = "1";
      btn.addEventListener("click", async () => {
        const confirmed = await (window as any).adminConfirm?.(
          "Avisar despacho",
          `¿Marcar el lote ${btn.dataset.period} como despachado y avisar por email a las destinatarias pendientes?`,
        );
        if (!confirmed) return;
        btn.disabled = true;
        btn.textContent = "Avisando...";
        try {
          const res = await fetch(`/api/admin/mail-club/batches/${btn.dataset.id}/dispatch`, { method: "POST" });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) {
            (window as any).adminToast?.(data.error || "Error en el despacho", "error");
            return;
          }
          const failed = (data.failed || []) as { email: string; error: string }[];
          let html = `<p class="font-sans text-sm text-triba-brown mb-2">Avisos enviados: <strong>${data.sent}</strong> · Fallidos: <strong>${failed.length}</strong></p>`;
          if (failed.length > 0) {
            html += `<ul class="font-sans text-xs text-triba-red space-y-1 mb-3">` +
              failed.map((f) => `<li>${escapeHtml(f.email)} — ${escapeHtml(f.error)}</li>`).join("") +
              `</ul><button id="mc-retry" type="button" class="rounded-button bg-triba-bone text-triba-brown border-2 border-triba-black px-4 py-2 font-heading text-xs uppercase tracking-wider hover:scale-[1.02] transition-all">Reintentar fallidos</button>`;
          }
          showResult(html);
          const retry = document.getElementById("mc-retry");
          if (retry) {
            retry.addEventListener("click", async () => {
              retry.setAttribute("disabled", "1");
              const r2 = await fetch(`/api/admin/mail-club/batches/${btn.dataset.id}/dispatch`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ emails: failed.map((f) => f.email) }),
              });
              const d2 = await r2.json().catch(() => ({}));
              if (!r2.ok) {
                (window as any).adminToast?.(d2.error || "Error reintentando", "error");
              } else {
                (window as any).adminToast?.(`Reintento: ${d2.sent} enviados, ${((d2.failed || []) as unknown[]).length} fallidos`, "success");
              }
    document.getElementById("mc-preview")!.addEventListener("click", async () => {
      const year = Number((document.getElementById("mc-year") as HTMLInputElement).value);
      const month = Number((document.getElementById("mc-month") as HTMLInputElement).value);
      const btn = document.getElementById("mc-preview") as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = "Simulando...";
      try {
        const res = await fetch("/api/admin/mail-club/batches/preview", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ year, month }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          (window as any).adminToast?.(data.error || "Error simulando", "error");
          return;
        }
        const skipped = (data.skipped || []) as { email: string; reason: string }[];
        const eligible = (data.eligible || []) as { email: string; zone: string; plan_currency: string; founder_number: number | null }[];
        let html = `<p class="font-sans text-sm text-triba-brown mb-1">Simulación (no se creó nada): <strong>${data.included}</strong> entrarían al lote.</p>`;
        if (eligible.length > 0) {
          html += `<ul class="font-sans text-xs text-triba-brown/70 space-y-1 mb-2 max-h-48 overflow-y-auto">` +
            eligible.map((e) => `<li>${escapeHtml(e.email)} · ${escapeHtml(e.zone)} · ${escapeHtml(e.plan_currency)}${e.founder_number ? ` · ✦ #${e.founder_number}` : ""}</li>`).join("") + `</ul>`;
        }
        if (skipped.length > 0) {
          html += `<p class="font-sans text-xs text-triba-red mb-1">Quedarían fuera (${skipped.length}):</p><ul class="font-sans text-xs text-triba-brown/70 space-y-1">` +
            skipped.map((s) => `<li>${escapeHtml(s.email || "sin email")} — ${escapeHtml(s.reason)}</li>`).join("") + `</ul>`;
        }
        showResult(html);
      } catch {
        (window as any).adminToast?.("Error de conexión", "error");
      } finally {
        btn.disabled = false;
        btn.textContent = "Simular";
      }
    });

    loadBatches();
    loadAttention();
            });
          }
          loadBatches();
        } catch {
          (window as any).adminToast?.("Error de conexión", "error");
        } finally {
          btn.disabled = false;
          btn.textContent = "Avisar despacho";
        }
      });
    });
  }

  async function loadBatchDetail(batchId: string, period: string) {
    const box = document.getElementById("mc-detail")!;
    box.innerHTML = `<p class="px-4 py-8 text-center text-triba-brown/50 font-sans text-sm">Cargando lote ${escapeHtml(period)}…</p>`;
    box.classList.remove("hidden");
    box.scrollIntoView({ behavior: "smooth", block: "nearest" });
    try {
      const res = await fetch(`/api/admin/mail-club/batches/${batchId}/items`);
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "Error");
      const items = data.items || [];
      if (items.length === 0) {
        box.innerHTML = `<p class="px-4 py-8 text-center text-triba-brown/50 font-sans text-sm">Lote ${escapeHtml(period)} sin destinatarias.</p>`;
        return;
      }
      const fmtDate = (iso: string) => {
        if (!iso) return "—";
        const d = new Date(iso);
        return isNaN(d.getTime()) ? "—" : d.toLocaleDateString("es-AR", { day: "2-digit", month: "2-digit", year: "numeric" });
      };
      const fmtAddress = (a: any) => {
        const line1 = [a.street_address, a.address_extra].filter(Boolean).join(", ");
        const line2 = [a.city, a.region].filter(Boolean).join(" · ");
        const line3 = [a.postal_code, a.country_iso].filter(Boolean).join(" ");
        return [line1, line2, line3].filter(Boolean).map(escapeHtml).join("<br />");
      };
      box.innerHTML = `
        <div class="flex items-center justify-between px-4 py-3 border-b-2 border-triba-black bg-triba-bone">
          <h3 class="font-heading text-sm uppercase tracking-wider text-triba-brown">Lote ${escapeHtml(period)} · ${items.length} destinataria(s)</h3>
          <button id="mc-detail-close" type="button" class="font-sans text-xs text-triba-brown hover:text-triba-red hover:underline min-h-[44px] px-2">Cerrar ✕</button>
        </div>
        <table class="w-full font-sans text-sm">
          <thead class="border-b border-triba-black/10">
            <tr>
              <th class="text-left px-4 py-2 font-heading text-[11px] uppercase tracking-wider text-triba-brown/60">Destinataria</th>
              <th class="text-left px-4 py-2 font-heading text-[11px] uppercase tracking-wider text-triba-brown/60">Dirección congelada</th>
              <th class="text-left px-4 py-2 font-heading text-[11px] uppercase tracking-wider text-triba-brown/60">Email</th>
              <th class="text-left px-4 py-2 font-heading text-[11px] uppercase tracking-wider text-triba-brown/60">Zona · Moneda</th>
              <th class="text-left px-4 py-2 font-heading text-[11px] uppercase tracking-wider text-triba-brown/60">Alta</th>
              <th class="text-left px-4 py-2 font-heading text-[11px] uppercase tracking-wider text-triba-brown/60">Estado</th>
            </tr>
          </thead>
          <tbody>
            ${items.map((it: any) => `
              <tr class="border-b border-triba-black/10 last:border-0">
                <td class="px-4 py-3 font-medium">${escapeHtml(it.address.recipient_name || "—")}${it.founder_number ? ` <span class="font-heading text-[10px] text-triba-red">✦ #${it.founder_number}</span>` : ""}</td>
                <td class="px-4 py-3 text-triba-brown/70 text-xs leading-relaxed">${fmtAddress(it.address)}</td>
                <td class="px-4 py-3 text-triba-brown/70 text-xs">${escapeHtml(it.email || "—")}</td>
                <td class="px-4 py-3 text-xs whitespace-nowrap">${escapeHtml(it.zone || "—")} · ${escapeHtml(it.plan_currency || "—")}</td>
                <td class="px-4 py-3 text-xs whitespace-nowrap">${fmtDate(it.joined_at)}</td>
                <td class="px-4 py-3 text-xs">${escapeHtml(it.live_status || it.status || "—")}</td>
              </tr>`).join("")}
          </tbody>
        </table>`;
      document.getElementById("mc-detail-close")!.addEventListener("click", () => box.classList.add("hidden"));
    } catch {
      box.innerHTML = `<p class="px-4 py-8 text-center text-triba-red/70 font-sans text-sm">Error al cargar el detalle</p>`;
    }
  }

  function initMailClub() {
    const now = new Date();
    (document.getElementById("mc-year") as HTMLInputElement).value = String(now.getFullYear());
    (document.getElementById("mc-month") as HTMLInputElement).value = String(now.getMonth() + 1);

    const retCheck = document.getElementById("mc-retention-check") as HTMLButtonElement;
    const retApply = document.getElementById("mc-retention-apply") as HTMLButtonElement;
    const retBox = document.getElementById("mc-retention-result")!;
    const renderRetention = (r: any, applied: boolean) => {
      retBox.innerHTML = `<p>Lotes vencidos: <strong>${r.oldBatches}</strong> · snapshots a purgar: <strong>${r.snapshotsToPurge}</strong> · direcciones a borrar: <strong>${r.addressesToDelete}</strong>${applied ? `<br />Aplicado: ${r.snapshotsPurged} purgados · ${r.addressesDeleted} borradas.` : ""}</p>`;
      retApply.classList.toggle("hidden", applied || (r.snapshotsToPurge === 0 && r.addressesToDelete === 0));
    };
    retCheck.addEventListener("click", async () => {
      retCheck.disabled = true;
      retCheck.textContent = "Revisando...";
      try {
        const res = await fetch("/api/admin/mail-club/retention?days=60");
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || "Error");
        renderRetention(data, false);
      } catch {
        retBox.innerHTML = `<p class="text-triba-red">Error al revisar</p>`;
      } finally {
        retCheck.disabled = false;
        retCheck.textContent = "Revisar";
      }
    });
    retApply.addEventListener("click", async () => {
      const confirmed = await (window as any).adminConfirm?.(
        "Aplicar purga",
        "¿Purgar snapshots vencidos y borrar direcciones sin Mail Club activo? No se puede deshacer.",
      );
      if (!confirmed) return;
      retApply.disabled = true;
      try {
        const res = await fetch("/api/admin/mail-club/retention", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ days: 60 }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          (window as any).adminToast?.(data.error || "Error aplicando", "error");
          return;
        }
        renderRetention(data, true);
        (window as any).adminToast?.("Purga aplicada", "success");
      } catch {
        (window as any).adminToast?.("Error de conexión", "error");
      } finally {
        retApply.disabled = false;
      }
    });

    document.getElementById("mc-create")!.addEventListener("click", async () => {
      const year = Number((document.getElementById("mc-year") as HTMLInputElement).value);
      const month = Number((document.getElementById("mc-month") as HTMLInputElement).value);
      const msg = document.getElementById("mc-create-msg")!;
      msg.classList.add("hidden");
      const btn = document.getElementById("mc-create") as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = "Creando...";
      try {
        const res = await fetch("/api/admin/mail-club/batches", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ year, month }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          msg.textContent = data.error || "Error creando el lote";
          msg.className = "font-sans text-sm text-triba-red mt-3";
          msg.classList.remove("hidden");
          return;
        }
        const skipped = (data.skipped || []) as { email: string; reason: string }[];
        let html = `<p class="font-sans text-sm text-triba-brown mb-2">Lote listo: <strong>${data.included}</strong> destinataria(s)${data.reused ? " (lote existente, sin duplicar)" : ""}.</p>`;
        if (skipped.length > 0) {
          html += `<p class="font-sans text-xs text-triba-brown/70 mb-1">Omitidas (no entran al lote):</p><ul class="font-sans text-xs text-triba-brown/70 space-y-1">` +
            skipped.map((s) => `<li>${escapeHtml(s.email || "sin email")} — ${escapeHtml(s.reason)}</li>`).join("") + `</ul>`;
        }
        showResult(html);
        (window as any).adminToast?.("Lote creado", "success");
        loadBatches();
      } catch {
        msg.textContent = "Error de conexión";
        msg.className = "font-sans text-sm text-triba-red mt-3";
        msg.classList.remove("hidden");
      } finally {
        btn.disabled = false;
        btn.textContent = "Crear lote";
      }
    });

    loadBatches();
  }

  onPageCycle(initMailClub);
</script>
