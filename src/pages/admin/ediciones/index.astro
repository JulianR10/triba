---
import AdminLayout from "../../../components/admin/AdminLayout.astro";
import { listEditionsForAdmin } from "../../../lib/admin/editions";

const editions = await listEditionsForAdmin();
---

<AdminLayout title="Ediciones" active="ediciones">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 mb-6">
    <p class="font-sans text-base text-triba-brown/70">
      {editions.length} {editions.length === 1 ? "edición" : "ediciones"} publicadas
    </p>
    <a href="/admin/ediciones/nuevo" class="rounded-button bg-triba-red text-triba-white border-2 border-triba-black px-5 py-2.5 font-heading text-xs uppercase tracking-wider hover:scale-[1.02] transition-all w-fit shrink-0 whitespace-nowrap">+ Nueva edición</a>
  </div>

  {
    editions.length === 0 ? (
      <div class="bg-triba-cream rounded-xl border-2 border-triba-black p-8 text-center">
        <p class="font-sans text-base text-triba-brown mb-4">Todavía no hay ediciones.</p>
        <a href="/admin/ediciones/nuevo" class="rounded-button bg-triba-red text-triba-white border-2 border-triba-black px-5 py-2.5 font-heading text-xs uppercase tracking-wider inline-block hover:scale-[1.02] transition-all">Crear la primera</a>
      </div>
    ) : (
      <div class="hidden md:block bg-triba-white rounded-xl border-2 border-triba-black overflow-x-auto">
        <table class="w-full font-sans text-sm">
          <thead class="bg-triba-bone border-b-2 border-triba-black">
            <tr>
              <th class="text-left px-4 py-3 font-heading text-xs uppercase tracking-wider">#</th>
              <th class="text-left px-4 py-3 font-heading text-xs uppercase tracking-wider">Título</th>
              <th class="text-left px-4 py-3 font-heading text-xs uppercase tracking-wider hidden md:table-cell">Publicada</th>
              <th class="text-left px-4 py-3 font-heading text-xs uppercase tracking-wider">Estado</th>
              <th class="text-right px-4 py-3 font-heading text-xs uppercase tracking-wider">Acciones</th>
            </tr>
          </thead>
          <tbody>
            {editions.map((e) => (
              <tr class="border-b border-triba-black/10 last:border-0 hover:bg-triba-bone/50">
                <td class="px-4 py-3 font-heading text-triba-red">#{e.edition_number}</td>
                <td class="px-4 py-3">
                  <div class="flex items-center gap-3">
                    <img src={e.cover_url} alt="" class="w-10 h-14 object-cover rounded border border-triba-black/20" />
                    <div>
                      <p class="font-heading text-sm uppercase tracking-wide flex items-center gap-2">
                        {e.title}
                        {e.kind === "free" && (
                          <span class="inline-block px-2 py-0.5 rounded-full bg-triba-green text-triba-brown font-heading text-[10px] uppercase tracking-wider">Gratis</span>
                        )}
                      </p>
                      {e.badge && <span class="font-sans text-xs text-triba-brown/60">{e.badge}</span>}
                    </div>
                  </div>
                </td>
                <td class="px-4 py-3 text-triba-brown/70 hidden md:table-cell">
                  {new Date(e.published_at).toLocaleDateString("es-AR", { day: "2-digit", month: "short", year: "numeric" })}
                </td>
                <td class="px-4 py-3">
                  {e.kind === "free" ? (
                    <span class="inline-block px-2 py-0.5 rounded-full bg-triba-bone text-triba-brown/60 font-heading text-[10px] uppercase tracking-wider">Artículo</span>
                  ) : e.featured ? (
                    <span class="inline-block px-2 py-0.5 rounded-full bg-triba-green text-triba-brown font-heading text-[10px] uppercase tracking-wider">Destacada</span>
                  ) : (
                    <span class="inline-block px-2 py-0.5 rounded-full bg-triba-bone text-triba-brown/60 font-heading text-[10px] uppercase tracking-wider">Normal</span>
                  )}
                </td>
                <td class="px-4 py-3 text-right">
                  <a href={`/admin/ediciones/${e.id}`} class="inline-flex items-center justify-center min-h-[44px] min-w-[44px] font-sans text-xs text-triba-red hover:underline">Editar</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="md:hidden flex flex-col gap-3">
        {editions.map((e) => (
          <div class="bg-triba-white rounded-xl border-2 border-triba-black p-4 flex gap-3 items-start">
            <img src={e.cover_url} alt="" class="w-12 h-16 object-cover rounded border border-triba-black/20 shrink-0" />
            <div class="flex-1 min-w-0">
              <p class="font-heading text-sm uppercase tracking-wide text-triba-brown flex items-center gap-2 flex-wrap">
                <span class="text-triba-red">#{e.edition_number}</span>
                <span class="truncate">{e.title}</span>
                {e.kind === "free" && (
                  <span class="inline-block px-2 py-0.5 rounded-full bg-triba-green text-triba-brown font-heading text-[10px] uppercase tracking-wider">Gratis</span>
                )}
              </p>
              {e.badge && <span class="font-sans text-xs text-triba-brown/60 block mt-0.5">{e.badge}</span>}
              <div class="flex items-center gap-2 mt-2 flex-wrap">
                {e.kind === "free" ? (
                  <span class="inline-block px-2 py-0.5 rounded-full bg-triba-bone text-triba-brown/60 font-heading text-[10px] uppercase tracking-wider">Artículo</span>
                ) : e.featured ? (
                  <span class="inline-block px-2 py-0.5 rounded-full bg-triba-green text-triba-brown font-heading text-[10px] uppercase tracking-wider">Destacada</span>
                ) : (
                  <span class="inline-block px-2 py-0.5 rounded-full bg-triba-bone text-triba-brown/60 font-heading text-[10px] uppercase tracking-wider">Normal</span>
                )}
                <span class="font-sans text-xs text-triba-brown/70">
                  {new Date(e.published_at).toLocaleDateString("es-AR", { day: "2-digit", month: "short", year: "numeric" })}
                </span>
              </div>
            </div>
            <a href={`/admin/ediciones/${e.id}`} class="inline-flex items-center justify-center min-h-[44px] min-w-[44px] font-sans text-xs text-triba-red hover:underline shrink-0 self-center">Editar</a>
          </div>
        ))}
      </div>
    )
  }
</AdminLayout>
