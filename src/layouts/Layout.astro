---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "./global.css";
import { SITE_URL } from "../lib/site-url";
import { t, type Locale } from "../i18n/ui";
import { isEnRoute, localizePath, toEsPath } from "../i18n/locale";

const { title, description, image, canonical, navLogoAlways, lang, alternateLanguages } = Astro.props as {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  navLogoAlways?: boolean;
  lang?: Locale;
  alternateLanguages?: { es: string; en: string } | false;
};

const locale = lang ?? "es";
const dict = t(locale);

const siteTitle = title ? `${title} — Triba` : dict.layout.defaultTitle;
const siteDescription = description || dict.layout.defaultDescription;
const ogImage = image || "/og-triba.png";
const siteUrl = SITE_URL;
const pageUrl = canonical ? `${siteUrl}${canonical}` : siteUrl;
const esCanonical = canonical ? toEsPath(canonical) : undefined;
const inferredAlternates = esCanonical &&
  esCanonical !== "/mi-cuenta" &&
  esCanonical !== "/iniciar-sesion" &&
  isEnRoute(esCanonical)
  ? { es: esCanonical, en: localizePath(esCanonical, "en") }
  : undefined;
const hreflangAlternates = alternateLanguages === false
  ? undefined
  : alternateLanguages ?? inferredAlternates;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Triba",
  url: siteUrl,
  description: dict.layout.jsonLdDescription,
  publisher: {
    "@type": "Organization",
    name: "Triba",
    logo: { "@type": "ImageObject", url: `${siteUrl}/logo-triba.svg` },
  },
};
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Local heading font -->
    <link rel="preload" href="/fonts/bootzyTM/BootzyTM.woff2" as="font" type="font/woff2" crossorigin />

    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />

    {canonical && <link rel="canonical" href={pageUrl} />}
    {hreflangAlternates && (
      <>
        <link rel="alternate" hreflang="es" href={`${siteUrl}${hreflangAlternates.es}`} />
        <link rel="alternate" hreflang="en" href={`${siteUrl}${hreflangAlternates.en}`} />
        <link rel="alternate" hreflang="x-default" href={`${siteUrl}${hreflangAlternates.es}`} />
      </>
    )}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content={dict.ogLocale} />
    <meta property="og:site_name" content="Triba" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={jsonLdText}></script>
  </head>
  <body class="bg-triba-bone text-triba-black text-pretty flex flex-col min-h-screen">
    <a class="skip-link" href="#main-content">{dict.layout.skipToContent}</a>
    <Navbar lang={locale} showLogoAlways={navLogoAlways} />
    <main id="main-content" tabindex="-1" class="relative z-0 flex-1 flex flex-col">
      <slot />
    </main>
    <Footer lang={locale} />

    <!-- Animation scripts -->
    <script src="/scripts/magnetic.js" is:inline></script>
    <script>
      import { onPageCycle } from "../lib/onPageCycle";
      (function () {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              var el = entry.target as HTMLElement & { _revealSplit?: boolean };

              if (el.hasAttribute("data-reveal-text") && !el._revealSplit) {
                el._revealSplit = true;
                var words = el.textContent.trim().split(/\s+/);
                if (words.length > 1) {
                  el.innerHTML = words
                    .map(function (w) {
                      return '<span class="reveal-word" style="display:inline-block">' + w + "</span>";
                    })
                    .join(" ");
                }
              }

              el.classList.add("revealed");

              if (el.dataset.revealOnce !== undefined || el.hasAttribute("data-reveal-once")) {
                observer.unobserve(el);
              }
            });
          },
          { threshold: 0.15, rootMargin: "0px 0px -40px 0px" }
        );

        function observeAll() {
          document.querySelectorAll("[data-reveal], [data-reveal-text], .reveal-stagger").forEach(function (el) {
            if (!el.classList.contains("revealed")) {
              observer.observe(el);
            }
          });
        }

        onPageCycle(observeAll);
      })();
    </script>
    <style>
      .skip-link {
        position: fixed;
        top: 1rem;
        left: 1rem;
        z-index: 100;
        transform: translateY(-200%);
        padding: 0.75rem 1rem;
        border: 2px solid #35220a;
        border-radius: 0.75rem;
        background: #fff;
        color: #35220a;
      }

      .skip-link:focus {
        transform: translateY(0);
      }

      #main-content:focus {
        outline: none;
      }
    </style>
  </body>
</html>
