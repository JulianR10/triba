---
import { t, type Locale } from "../i18n/ui";
import { localizePath } from "../i18n/locale";

const { lang = "es" } = Astro.props as { lang?: Locale };
const dict = t(lang);
---

<footer class="relative z-20 bg-triba-white border-t-4 border-triba-black pt-6 md:pt-8 page-gutter pb-[calc(1.5rem+env(safe-area-inset-bottom))] md:pb-[calc(2rem+env(safe-area-inset-bottom))]">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-y-4 md:gap-y-0 gap-x-6 font-sans text-sm">
    <a href={localizePath("/", lang)} class="inline-flex md:order-2">
      <img src="/logo-triba.svg" alt="Triba" class="h-[28px]" />
    </a>
    <div class="flex items-center gap-x-5 md:order-1">
      <a href={localizePath("/privacidad", lang)} class="text-triba-brown/70 hover:text-triba-red transition-colors">{dict.footer.privacy}</a>
      <a href={localizePath("/terminos", lang)} class="text-triba-brown/70 hover:text-triba-red transition-colors">{dict.footer.terms}</a>
    </div>
    <div class="flex items-center gap-[5px] md:order-3">
      <h3 class="font-heading text-xs uppercase tracking-wider text-triba-brown">{dict.footer.madeBy}</h3>
      <a href="https://julianrecarte.dev/es/" target="_blank" rel="noopener noreferrer" class="inline-flex">
        <img src="/firma.png" alt="Firma" class="h-[22px]" />
      </a>
    </div>
  </div>
</footer>