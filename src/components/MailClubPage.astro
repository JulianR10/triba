---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import PatchTitle from "../components/PatchTitle.astro";
import { t, type Locale } from "../i18n/ui";
import { localizePath } from "../i18n/locale";

const { lang = "es" } = Astro.props as { lang?: Locale };
const dict = t(lang);
const page = dict.mailClubPage;
const canonical = lang === "en" ? "/en/mail-club" : "/mail-club";
const subscribeHref = localizePath("/suscribirme", lang);
const faqs = dict.subscribe.faqs;
---

<style>
  /* Hallmark · macrostructure: Manifesto · genre: editorial · theme: triba-brand (locked tokens)
   * pre-emit critique: P5 H4 E5 S4 R5 V4 · nav/footer: global chrome preserved (out of scope)
   * reveal: hero entrance only · copy/brand/routes unchanged */
  details[data-faq] .faq-content {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 1s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  details[data-faq][open] .faq-content {
    grid-template-rows: 1fr;
  }
  details[data-faq] .faq-content-inner {
    min-height: 0;
    overflow: hidden;
  }
</style>

<Layout title={page.title} description={page.description} canonical={canonical} lang={lang} navLogoAlways>
  <section class="page-shell page-gutter bg-triba-bone overflow-x-clip">
    <div class="max-w-6xl mx-auto">

      <!-- Declaración -->
      <div class="max-w-3xl mb-20 md:mb-28 pt-8 md:pt-12 reveal-text" data-reveal>
        <PatchTitle content={page.heroTitle} tag="h1" centered={false} class="text-5xl md:text-7xl text-triba-brown" />
        <p class="font-serif italic text-xl md:text-2xl text-triba-red mt-6">{page.heroLead}</p>
        <p class="font-sans text-base md:text-lg text-triba-brown leading-relaxed mt-6 text-balance">
          {page.heroBody}
        </p>
        <div class="mt-10">
          <Button variant="primary" size="md" href={subscribeHref} class="px-10 py-4 text-base">{page.heroButton}</Button>
        </div>
      </div>

      <div class="rounded-xl border-2 border-triba-black overflow-hidden mb-20 md:mb-28 bg-triba-cream">
        <img src="https://picsum.photos/seed/triba-mailclub-hero/1280/720" alt={page.heroTitle} fetchpriority="high" width="1280" height="720" class="w-full aspect-[16/9] object-cover" />
      </div>

      <!-- Qué trae tu sobre · lista póster alternada -->
      <h2 class="font-heading text-3xl md:text-5xl uppercase tracking-wide text-triba-brown mb-12 md:mb-16 max-w-3xl">{page.box2Title}</h2>
      <ul class="mb-10 md:mb-14">
        {page.box2Items.map((item, i) => (
          <li class={`flex items-center gap-5 md:gap-10 mb-10 md:mb-14 ${i % 2 === 1 ? "md:flex-row-reverse md:text-right" : ""}`}>
            <img src={`https://picsum.photos/seed/triba-mailclub-${i + 1}/400/300`} alt={item} loading="lazy" width="400" height="300" class={`object-cover rounded-lg border-2 border-triba-black shrink-0 bg-triba-cream ${i % 2 === 1 ? "w-36 h-28 md:w-52 md:h-40 rotate-2" : "w-28 h-24 md:w-40 md:h-32 -rotate-2"}`} />
            <p class="font-heading text-lg md:text-2xl uppercase tracking-wide text-triba-brown leading-snug"><span class="text-triba-red">✦</span> {item}</p>
          </li>
        ))}
      </ul>
      <p class="font-sans text-base text-triba-brown/80 mb-20 md:mb-28 text-balance max-w-2xl">{page.box2Note}</p>

      <!-- Cómo funciona · declaraciones numeradas -->
      <h2 class="font-heading text-3xl md:text-5xl uppercase tracking-wide text-triba-brown mb-12 md:mb-16 max-w-3xl">{page.box3Title}</h2>
      <ol class="mb-20 md:mb-28">
        {page.box3Steps.map((step, i) => (
          <li class={`flex gap-5 md:gap-8 items-baseline mb-10 md:mb-12 max-w-3xl ${i % 2 === 1 ? "md:ml-24" : ""}`}>
            <span class="shrink-0 font-heading text-5xl md:text-7xl text-triba-red leading-none">{i + 1}</span>
            <p class="font-sans text-base md:text-xl text-triba-brown leading-relaxed">{step}</p>
          </li>
        ))}
      </ol>

      <!-- Cierre -->
      <div class="bg-triba-pink rounded-xl border-2 border-triba-black p-8 md:p-12 mb-20 md:mb-28 max-w-4xl">
        <p class="font-sans text-base md:text-lg text-triba-brown mb-3">{page.closingTitle}</p>
        <p class="font-serif italic text-2xl md:text-4xl text-triba-brown mb-10">{page.closingBody}</p>
        <Button variant="primary" size="md" href={subscribeHref} class="px-10 py-4 text-base">{page.closingButton}</Button>
      </div>

      <!-- FAQ -->
      <div class="mb-8 max-w-4xl">
        <h2 class="font-heading text-2xl md:text-3xl uppercase tracking-wide text-triba-brown mb-8">{page.faqTitle}</h2>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <details data-faq class="bg-triba-cream rounded-xl border-2 border-triba-black overflow-hidden group transition-shadow duration-300 hover:shadow-md">
              <summary class="px-5 py-4 font-heading text-sm font-medium uppercase tracking-wider text-triba-brown cursor-pointer list-none flex items-center justify-between">
                {faq.q}
                <span class="text-triba-red text-lg transition-transform duration-300 group-open:rotate-45 shrink-0 ml-3">+</span>
              </summary>
              <div class="faq-content">
                <div class="faq-content-inner px-5 pb-4 font-sans text-base text-triba-brown leading-relaxed">
                  {faq.a}
                </div>
              </div>
            </details>
          ))}
        </div>
      </div>

    </div>
  </section>
</Layout>

<script>
  import { onPageCycle } from "../lib/onPageCycle";

  function setup() {
    var faqDetails = document.querySelectorAll<HTMLDetailsElement>("details[data-faq]");
    faqDetails.forEach(function (detail) {
      detail.addEventListener("toggle", function () {
        if (detail.open) {
          faqDetails.forEach(function (other) {
            if (other !== detail) other.open = false;
          });
        }
      });
    });
  }

  onPageCycle(setup);
</script>
