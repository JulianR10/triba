---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import PDFViewer from "../components/PDFViewer.tsx";
import PatchTitle from "../components/PatchTitle.astro";
import { t, type Locale } from "../i18n/ui";
import { localizePath } from "../i18n/locale";

import { createSupabaseServerClient } from "../lib/supabase-server";
import { getEditions, getFeaturedEdition } from "../lib/editions";
import { getSignedPdfUrl } from "../lib/storage";
import { isActiveSubscription, subscriptionStatusInfo } from "../lib/subscription-status";
import { getCheckoutOutcome } from "../lib/checkout-status";
import type { Profile, Subscription } from "../lib/types";

const { lang = "es" } = Astro.props as { lang?: Locale };
const dict = t(lang);
const canonical = lang === "en" ? "/en/mi-cuenta" : "/mi-cuenta";

const supabase = createSupabaseServerClient(Astro.request);
const { data: { session } } = await supabase.auth.getSession();
const user = session?.user ?? null;

let profile: Profile | null = null;
let subscription: Subscription | null = null;

if (user) {
  // P7: preferir locals centralizados (middleware), fallback a queries directas
  const localsProfile = (Astro.locals as any).profile as Profile | null | undefined;
  const localsSubscription = (Astro.locals as any).subscription as Subscription | null | undefined;
  const localsHasActive = (Astro.locals as any).hasActiveSub as boolean | undefined;
  if (localsProfile !== undefined) {
    profile = localsProfile;
    subscription = localsSubscription ?? null;
  } else {
    const { data: p } = await supabase.from("profiles").select("*").eq("id", user.id).single();
    profile = p;
    if (profile?.subscription_id) {
      const { data: s } = await supabase.from("subscriptions").select("*").eq("id", profile.subscription_id).single();
      subscription = s;
    }
  }
}

const hasActiveSub =
  typeof (Astro.locals as any).hasActiveSub === "boolean"
    ? (Astro.locals as any).hasActiveSub
    : isActiveSubscription(
        subscription?.status ?? null,
        subscription?.current_period_end ?? undefined,
      );

const subscriptionInfo = subscriptionStatusInfo(subscription?.status, lang);

const isAdmin = profile?.role === "admin";

const allEditions = await getEditions(lang);
const featuredEdition = await getFeaturedEdition(lang);

const editions = allEditions.map((e) => ({
  id: e.id,
  edition: `#${e.edition_number}`,
  title: e.title,
  description: e.description,
  cover: e.cover_url,
  pdf: e.pdf_url ? `/api/pdf/${e.id}?lang=${lang}` : "#",
  featured: e.featured,
  badge: e.badge,
  hasEn: e.hasEn,
  isFallback: e.isFallback,
  language: e.language,
  slug: `edicion-${e.edition_number}`,
  previewArticle: true,
}));

const editionsPayload = editions.map((e) => ({
  slug: e.slug,
  title: e.title,
  cover: e.cover,
  edition: e.edition,
  badge: e.badge,
  hasEn: e.hasEn,
  isFallback: e.isFallback,
}));

const featured = editions.find((e) => e.featured) || editions[0];
const featuredEditionRaw = featuredEdition ?? allEditions[0];
const featuredPdfSignedUrl = featuredEditionRaw?.pdf_url
  ? await getSignedPdfUrl(featuredEditionRaw.pdf_url).catch(() => null) ?? featured.pdf
  : undefined;

const checkoutOutcome = getCheckoutOutcome(Astro.url.searchParams);

const displayName = user?.user_metadata?.full_name || user?.email?.split("@")[0] || (lang === "en" ? "reader" : "lectora");

const subscribeHref = localizePath("/suscribirme", lang);

const comingSoonLabel = (dict.magazine as { comingSoon?: string }).comingSoon ?? "EN coming soon";
const miCuentaMessages = {
  lang,
  revistaBase: lang === "en" ? "/en/revista/" : "/revista/",
  coverCardAlt: dict.miCuenta.coverCardAlt,
  slideAria: dict.miCuenta.slideAria,
  feedbackSending: dict.miCuenta.feedbackSending,
  feedbackSubmit: dict.miCuenta.feedbackSubmit,
  feedbackNeedLogin: dict.miCuenta.feedbackNeedLogin,
  feedbackWait: dict.miCuenta.feedbackWait,
  feedbackError: dict.miCuenta.feedbackError,
  feedbackThanks: dict.miCuenta.feedbackThanks,
  feedbackConn: dict.miCuenta.feedbackConn,
  processingNote2: dict.miCuenta.processingNote2,
  processingNetworkError: dict.miCuenta.processingNetworkError,
  comingSoon: comingSoonLabel,
  badgeEn: "EN",
};
---

<Layout title={dict.miCuenta.title} description={dict.miCuenta.description} canonical={canonical} lang={lang} navLogoAlways>
  <section class="pt-0 md:pt-[max(1rem,var(--nav-height,64px))]" data-mi-cuenta-messages={JSON.stringify(miCuentaMessages)}>
    <div class="max-w-6xl mx-auto">

      {checkoutOutcome === "success" && (
        <div data-banner="checkout-success" class="mx-5 md:mx-10 lg:mx-20 xl:mx-32 2xl:mx-48 mb-8 p-4 bg-triba-green/20 border-2 border-triba-green rounded-xl flex items-start justify-between gap-3 reveal" data-reveal>
          <div>
            <p class="font-heading text-sm uppercase tracking-wider text-triba-brown mb-1">{dict.miCuenta.checkoutSuccessTitle}</p>
            <p class="font-sans text-base text-triba-brown">{dict.miCuenta.checkoutSuccessBody}</p>
          </div>
          <button type="button" data-dismiss-banner class="shrink-0 text-triba-brown hover:text-triba-red text-xl leading-none" aria-label={dict.miCuenta.dismiss}>×</button>
        </div>
      )}

      {checkoutOutcome === "canceled" && (
        <div data-banner="checkout-canceled" class="mx-5 md:mx-10 lg:mx-20 xl:mx-32 2xl:mx-48 mb-8 p-4 bg-triba-red/10 border-2 border-triba-red rounded-xl flex items-start justify-between gap-3 reveal" data-reveal>
          <div>
            <p class="font-heading text-sm uppercase tracking-wider text-triba-brown mb-1">{dict.miCuenta.checkoutCanceledTitle}</p>
            <p class="font-sans text-base text-triba-brown">{dict.miCuenta.checkoutCanceledBody}</p>
          </div>
          <button type="button" data-dismiss-banner class="shrink-0 text-triba-brown hover:text-triba-red text-xl leading-none" aria-label={dict.miCuenta.dismiss}>×</button>
        </div>
      )}

      {checkoutOutcome === "pending" && (
        <div data-banner="checkout-pending" class="mx-5 md:mx-10 lg:mx-20 xl:mx-32 2xl:mx-48 mb-8 p-4 bg-triba-pink/30 border-2 border-triba-pink rounded-xl flex items-start justify-between gap-3 reveal" data-reveal>
          <div>
            <p class="font-heading text-sm uppercase tracking-wider text-triba-brown mb-1">{dict.miCuenta.checkoutPendingTitle}</p>
            <p class="font-sans text-base text-triba-brown">{dict.miCuenta.checkoutPendingBody}</p>
          </div>
          <button type="button" data-dismiss-banner class="shrink-0 text-triba-brown hover:text-triba-red text-xl leading-none" aria-label={dict.miCuenta.dismiss}>×</button>
        </div>
      )}

      {
        hasActiveSub && (
          <>

      <!-- ===== HERO ===== -->
      <div class="relative overflow-hidden rounded-none md:rounded-[32px] bg-gradient-to-br from-triba-pink via-triba-pink/60 to-triba-cream px-5 md:px-14 lg:px-20 py-10 md:py-16 lg:py-20 reveal" data-reveal>
        <div class="grid grid-cols-1 md:grid-cols-2 md:gap-12 md:items-center">
          <p class="font-heading text-sm md:text-base uppercase tracking-[0.2em] text-triba-brown/60 mb-4 md:col-start-1 md:row-start-1">{dict.miCuenta.monthlyEdition}</p>
          <h1 class="font-heading text-4xl sm:text-5xl md:text-6xl lg:text-7xl text-triba-brown leading-tight mb-2 md:col-start-1 md:row-start-2">
            {dict.miCuenta.hello} <span class="text-triba-red">{displayName}</span>
          </h1>
          <div class="w-full flex justify-center md:col-start-2 md:row-start-1 md:row-span-3 md:justify-end mt-4 mb-6 md:mt-0 md:mb-0">
            <div class="w-56 sm:w-64 md:w-72 lg:w-80 -rotate-[3deg] hover:rotate-0 transition-transform duration-500">
              <img src={featured.cover} alt={dict.miCuenta.coverAlt.replace("{title}", featured.title)} fetchpriority="high" class="w-full rounded-xl border-2 border-triba-black shadow-[8px_8px_0px_0px_rgba(0,0,0,0.15)]" />
            </div>
          </div>
          <div class="md:col-start-1 md:row-start-3">
            <div class="mt-6 mb-3 flex flex-col items-center md:items-start gap-2">
              <h2 class="font-heading text-2xl md:text-3xl text-triba-brown text-center md:text-left">{featured.title}</h2>
              {featured.badge && (
                <span class="inline-flex px-2.5 py-1 rounded-full bg-triba-white border border-triba-black/10 font-heading text-[10px] uppercase tracking-wider text-triba-brown">{featured.badge}</span>
              )}
              {lang === "en" && featured.isFallback && (
                <span class="inline-flex px-2.5 py-1 rounded-full bg-triba-bone font-heading text-[10px] uppercase tracking-wider text-triba-brown/60">{comingSoonLabel}</span>
              )}
              {lang === "en" && !featured.isFallback && featured.hasEn && !featured.badge && (
                <span class="inline-flex px-2.5 py-1 rounded-full bg-triba-green font-heading text-[10px] uppercase tracking-wider text-triba-brown">EN</span>
              )}
            </div>
            <p class="font-sans text-base md:text-base text-triba-brown/80 leading-relaxed mb-8 max-w-lg whitespace-pre-line text-center md:text-left mx-auto md:mx-0 mt-3">
              {featured.description}
            </p>
            <div class="flex flex-wrap gap-4 justify-center md:justify-start">
              {featured.pdf !== "#" && (
                <Button variant="primary" size="md" href="#visor-revista">{dict.miCuenta.continueReading}</Button>
              )}
              {featured.pdf !== "#" && (
                <Button variant="ghost" size="md" href={`${featured.pdf}&download=1`}>{dict.miCuenta.downloadPdf}</Button>
              )}
            </div>
          </div>
        </div>
      </div>

      <!-- Admin banner -->
      {isAdmin && (
        <div class="mt-4 mx-5 md:mx-14 lg:mx-20 mb-8 reveal" data-reveal>
          <div class="bg-triba-green/30 rounded-xl border-2 border-triba-black p-6 text-center max-w-lg mx-auto">
            <p class="font-heading text-xs uppercase tracking-wider text-triba-brown mb-1">{dict.miCuenta.adminSession}</p>
            <p class="font-sans text-base text-triba-brown mb-4 text-balance" set:html={dict.miCuenta.adminLoggedIn}></p>
            <Button variant="primary" href="/admin">{dict.miCuenta.goToAdmin}</Button>
          </div>
        </div>
      )}

      <!-- ===== COLECCIÓN (carrusel "Tus tomos") ===== -->
      <div id="tus-tomos" class="relative px-5 md:px-14 lg:px-20 py-12 md:py-16 reveal shadow-[inset_0_12px_18px_-14px_rgba(0,0,0,0.15),inset_0_-12px_18px_-14px_rgba(0,0,0,0.15)]" data-reveal>
        <!-- sombras internas sutiles top/bottom del contenedor de sección -->
        <div class="pointer-events-none absolute inset-x-0 top-0 h-8 bg-gradient-to-b from-black/10 to-transparent"></div>
        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-8 bg-gradient-to-t from-black/10 to-transparent"></div>
        <div class="max-w-6xl mx-auto">
          <p class="font-heading text-xs uppercase tracking-[0.25em] text-triba-brown/50 mb-8">{dict.miCuenta.tusTomos}</p>

          <div class="relative px-10 md:px-14" data-tomos-wrap>
            <button
              type="button"
              data-tomos-prev
              aria-label={dict.miCuenta.prevAria}
              class="absolute left-0 top-1/2 -translate-y-1/2 z-10 w-10 h-10 md:w-12 md:h-12 flex items-center justify-center font-sans text-2xl md:text-3xl text-triba-brown hover:text-triba-red transition-colors"
            >‹</button>

            <div
              data-tomos-track
              class="flex gap-4 md:gap-6 overflow-x-auto scrollbar-hide snap-x snap-mandatory"
            ></div>

            <button
              type="button"
              data-tomos-next
              aria-label={dict.miCuenta.nextAria}
              class="absolute right-0 top-1/2 -translate-y-1/2 z-10 w-10 h-10 md:w-12 md:h-12 flex items-center justify-center font-sans text-2xl md:text-3xl text-triba-brown hover:text-triba-red transition-colors"
            >›</button>
          </div>

          <div class="flex justify-center gap-2 mt-8" data-tomos-dots></div>
        </div>
      </div>

      <script type="application/json" data-tomos-data set:html={JSON.stringify(editionsPayload)}></script>

      <!-- ===== VISOR ===== -->
      <div class="bg-triba-cream w-full px-5 md:px-14 lg:px-20 xl:px-32 2xl:px-48 py-12 md:py-20">
        <div class="max-w-6xl mx-auto">
          {featured.pdf !== "#" && (
          <div id="visor-revista" class="scroll-anchor reveal" data-reveal>
            <PatchTitle content={featured.title} tag="h2" class="text-2xl md:text-3xl text-triba-brown mb-8" />

            <div class="-mx-5 md:mx-0">
              <PDFViewer pdfUrl={featuredPdfSignedUrl || ''} lang={lang} client:only="react" />
            </div>

            <p class="font-heading text-xs uppercase tracking-[0.2em] text-triba-brown/40 text-center mt-6">{dict.miCuenta.viewerHint}</p>
          </div>
          )}
        </div>
      </div>

      <!-- ===== FEEDBACK ===== -->
      <div class="px-5 md:px-14 lg:px-20 py-12 md:py-16">
        <div class="max-w-lg mx-auto reveal" data-reveal>
          <h2 class="font-heading text-2xl md:text-3xl text-triba-brown text-center mb-8">{dict.miCuenta.feedbackTitle}</h2>

          <form id="feedback-form">
            <textarea
              name="feedback"
              rows="4"
              placeholder={dict.miCuenta.feedbackPlaceholder}
              maxlength="2000"
              class="w-full px-5 py-4 rounded-xl border-2 border-triba-black bg-triba-white font-sans text-sm text-triba-brown outline-none focus:border-triba-red transition-colors resize-none mb-3"
            ></textarea>
            <div class="flex items-center justify-between gap-4">
              <span id="feedback-counter" class="font-sans text-xs text-triba-brown/50">0 / 2000</span>
              <Button variant="primary" type="submit">{dict.miCuenta.feedbackSubmit}</Button>
            </div>
            <p id="feedback-msg" class="font-sans text-sm text-center mt-3 hidden"></p>
          </form>
        </div>
      </div>

        </>
        )
      }

      {
        !hasActiveSub && (
          <div class="max-w-lg mx-auto mt-10 text-center reveal px-5" data-reveal>
            <div class="bg-triba-cream rounded-xl border-2 border-triba-black p-8">
              {
                checkoutOutcome === "canceled" ? (
                  <>
                    <h2 class="font-heading text-base uppercase tracking-wider text-triba-brown mb-2">{dict.miCuenta.paymentCanceledTitle}</h2>
                    <p class="font-sans text-base text-triba-brown/70 mb-6 leading-relaxed">{dict.miCuenta.paymentCanceledBody}</p>
                    <Button variant="primary" href={subscribeHref}>{dict.miCuenta.subscribe}</Button>
                  </>
                ) : checkoutOutcome === "success" || checkoutOutcome === "pending" ? (
                  <>
                    <h2 class="font-heading text-base uppercase tracking-wider text-triba-brown mb-2">{dict.miCuenta.processingTitle}</h2>
                    <p data-processing-note class="font-sans text-base text-triba-brown/70 mb-6 leading-relaxed">{dict.miCuenta.processingNote}</p>
                    <div class="flex justify-center">
                      <div class="w-6 h-6 border-2 border-triba-red border-t-2 border-t-transparent rounded-full animate-spin"></div>
                    </div>
                  </>
                ) : (
                  <>
                    <h2 class="font-heading text-base uppercase tracking-wider text-triba-brown mb-2">{subscriptionInfo.label}</h2>
                    {subscriptionInfo.action ? (
                      <>
                        <p class="font-sans text-base text-triba-brown/70 mb-6 leading-relaxed">{dict.miCuenta.updatePaymentBody}</p>
                        <button type="button" class="manage-sub-btn rounded-button bg-triba-red text-triba-white border-2 border-triba-black px-8 py-3 font-heading text-base uppercase tracking-wider hover:scale-[1.02] transition-all">
                          {subscriptionInfo.action}
                        </button>
                      </>
                    ) : (
                      <>
                        <p class="font-sans text-base text-triba-brown/70 mb-6 leading-relaxed">{dict.miCuenta.noSubBody}</p>
                        <Button variant="primary" href={subscribeHref}>{dict.miCuenta.subscribe}</Button>
                      </>
                    )}
                  </>
                )
              }
            </div>
          </div>
        )
      }

    </div>
  </section>
</Layout>

<script>
  import { supabase } from "../lib/supabase";
  import { onPageCycle } from "../lib/onPageCycle";
  import { getCheckoutOutcome, isAwaitingActivation } from "../lib/checkout-status";
  import { startCheckoutPoll } from "../scripts/checkout-poll";

  function setup() {

  var messagesEl = document.querySelector<HTMLElement>("[data-mi-cuenta-messages]");
  var messages: Record<string, string> = {
    lang: "es",
    revistaBase: "/revista/",
    coverCardAlt: "Portada {edition} — {title}",
    slideAria: "Ir a página {n}",
    feedbackSending: "Enviando...",
    feedbackSubmit: "Enviar",
    feedbackNeedLogin: "Debés iniciar sesión para enviar feedback",
    feedbackWait: "Esperá un momento antes de enviar otro feedback",
    feedbackError: "Error al enviar. Intentalo de nuevo.",
    feedbackThanks: "¡Gracias por tu feedback!",
    feedbackConn: "Error de conexión. Intentalo de nuevo.",
    processingNote2: "Todavía estamos confirmando tu pago. Si se demora más de un minuto, actualizá la página.",
    processingNetworkError: "Conexión inestable, seguimos intentando...",
    comingSoon: "EN coming soon",
    badgeEn: "EN",
  };
  var raw = messagesEl?.getAttribute("data-mi-cuenta-messages");
  if (raw) {
    try { Object.assign(messages, JSON.parse(raw)); } catch { /* keep defaults */ }
  }

  // --- Post-checkout state: consume the return URL and watch for activation ---
  var checkoutOutcome = getCheckoutOutcome(new URLSearchParams(window.location.search));

  // Mercado Pago overwrites back_url's query with its own params. Once they've
  // been consumed by the SSR render, drop them so a later refresh doesn't
  // re-trigger a stale "success"/"canceled" state. Stripe's explicit
  // ?checkout=success is preserved (existing banner behavior).
  if (!new URLSearchParams(window.location.search).get("checkout") && checkoutOutcome !== "none") {
    history.replaceState(null, "", window.location.pathname);
  }

  if (
    isAwaitingActivation(checkoutOutcome) &&
    document.querySelector("[data-processing-note]")
  ) {
    startCheckoutPoll(async function () {
      if (!supabase) return undefined;
      var { data: { session } } = await supabase.auth.getSession();
      return session?.access_token;
    }, function () {
      var note = document.querySelector("[data-processing-note]");
      if (note) note.textContent = messages.processingNote2;
    }, function () {
      var note = document.querySelector("[data-processing-note]");
      if (note) note.textContent = messages.processingNetworkError;
    });
  }

  // --- Tus tomos: carrusel paginado (mobile 2x2 / desktop 2 filas de 4) ---
  var dataEl = document.querySelector<HTMLElement>("[data-tomos-data]");
  if (dataEl) {
    var editionsList: { slug: string; title: string; cover: string; edition: string; badge: string | null; hasEn: boolean; isFallback: boolean }[] = JSON.parse(dataEl.textContent || "[]");
    var wrap = document.querySelector<HTMLElement>("[data-tomos-wrap]");
    var track = wrap && wrap.querySelector<HTMLElement>("[data-tomos-track]");
    var dotsBox = document.querySelector<HTMLElement>("[data-tomos-dots]");
    var prevBtn = wrap && wrap.querySelector<HTMLButtonElement>("[data-tomos-prev]");
    var nextBtn = wrap && wrap.querySelector<HTMLButtonElement>("[data-tomos-next]");

    function tomosPerPage() {
      return window.matchMedia("(min-width: 768px)").matches ? 8 : 4;
    }

    function buildTomos() {
      if (!track || !dotsBox || !prevBtn || !nextBtn || !editionsList.length) return;
      var n = tomosPerPage();
      var pages: typeof editionsList[] = [];
      for (var i = 0; i < editionsList.length; i += n) {
        pages.push(editionsList.slice(i, i + n));
      }

      track.innerHTML = pages
        .map(function (page) {
          return (
            '<div class="flex-none w-full snap-start">' +
            '<div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-5">' +
            page
              .map(function (ed) {
                var pill = "";
                if (ed.badge) {
                  pill = '<span class="absolute top-2 right-2 z-10 inline-flex px-2 py-0.5 rounded-full bg-triba-white border border-triba-black/10 font-heading text-[10px] uppercase tracking-wider text-triba-brown">' + ed.badge + "</span>";
                } else if (messages.lang === "en" && ed.isFallback) {
                  pill = '<span class="absolute top-2 right-2 z-10 inline-flex px-2 py-0.5 rounded-full bg-triba-bone font-heading text-[10px] uppercase tracking-wider text-triba-brown/60">' + (messages.comingSoon || "EN coming soon") + "</span>";
                } else if (messages.lang === "en" && ed.hasEn) {
                  pill = '<span class="absolute top-2 right-2 z-10 inline-flex px-2 py-0.5 rounded-full bg-triba-green font-heading text-[10px] uppercase tracking-wider text-triba-brown">' + (messages.badgeEn || "EN") + "</span>";
                }
                return (
                  '<a href="' + messages.revistaBase + ed.slug + '#visor-revista" class="group block">' +
                  '<div class="relative aspect-[3/4] rounded-xl overflow-hidden border-2 border-triba-black shadow-lg transition-all duration-400 group-hover:rotate-0 group-hover:scale-[1.04] group-hover:shadow-2xl">' +
                  '<img src="' + ed.cover + '" alt="' + messages.coverCardAlt.replace("{edition}", ed.edition).replace("{title}", ed.title) + '" loading="lazy" class="w-full h-full object-cover" />' + pill +
                  "</div>" +
                  '<p class="font-heading text-xs uppercase tracking-wider text-triba-brown/60 text-center mt-2 leading-relaxed">' + ed.title + "</p>" +
                  "</a>"
                );
              })
              .join("") +
            "</div></div>"
          );
        })
        .join("");

      dotsBox.innerHTML = pages
        .map(function (_, i) {
          return (
            '<button type="button" data-tomos-dot="' + i + '" aria-label="' + messages.slideAria.replace("{n}", String(i + 1)) + '" class="w-2.5 h-2.5 rounded-full bg-triba-brown/25 transition-all hover:scale-125"></button>'
          );
        })
        .join("");
      dotsBox.style.display = pages.length > 1 ? "" : "none";

      track.scrollLeft = 0;
      updateTomosUI();
    }

    function updateTomosUI() {
      if (!track || !prevBtn || !nextBtn || !dotsBox) return;
      var scrollLeft = track.scrollLeft;
      var width = track.clientWidth || 1;
      var idx = Math.round(scrollLeft / width);
      var maxIdx = Math.max(0, Math.round((track.scrollWidth - track.clientWidth) / width));
      prevBtn.style.opacity = idx <= 0 ? "0.35" : "1";
      nextBtn.style.opacity = idx >= maxIdx ? "0.35" : "1";
      dotsBox.querySelectorAll<HTMLButtonElement>("[data-tomos-dot]").forEach(function (d, i) {
        d.className = "w-2.5 h-2.5 rounded-full transition-colors " + (i === idx ? "bg-triba-red" : "bg-triba-brown/25");
      });
    }

    if (track && prevBtn && nextBtn && dotsBox) {
      track.addEventListener("scroll", updateTomosUI, { passive: true });
      prevBtn.addEventListener("click", function () {
        track!.scrollBy({ left: -(track!.clientWidth || 0), behavior: "smooth" });
      });
      nextBtn.addEventListener("click", function () {
        track!.scrollBy({ left: track!.clientWidth || 0, behavior: "smooth" });
      });
      dotsBox.addEventListener("click", function (e) {
        var b = (e.target as HTMLElement).closest("[data-tomos-dot]");
        if (b) {
          var idx = Number(b.getAttribute("data-tomos-dot"));
          track!.scrollTo({ left: idx * (track!.clientWidth || 1), behavior: "smooth" });
        }
      });
      var rsT: number | undefined;
      window.addEventListener("resize", function () {
        window.clearTimeout(rsT);
        rsT = window.setTimeout(buildTomos, 150);
      });
      buildTomos();
    }
  }

  // --- Feedback form ---
  const fbForm = document.getElementById("feedback-form");
  const fbMsg = document.getElementById("feedback-msg")!;
  const fbTextarea = fbForm?.querySelector("textarea[name=feedback]") as HTMLTextAreaElement | null;
  const fbCounter = document.getElementById("feedback-counter");
  const fbBtn = fbForm?.querySelector("button[type=submit]") as HTMLButtonElement | null;
  let fbTimer: number | undefined;

  const updateCounter = () => {
    if (!fbTextarea || !fbCounter) return;
    const len = fbTextarea.value.length;
    fbCounter.textContent = len + " / 2000";
    fbCounter.className = len > 2000
      ? "font-sans text-xs text-triba-red"
      : "font-sans text-xs text-triba-brown/50";
    if (fbBtn) fbBtn.disabled = len === 0 || len > 2000;
  };

  if (fbTextarea && fbCounter) {
    fbTextarea.addEventListener("input", updateCounter);
    updateCounter();
  }

  if (fbForm) {
    fbForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      fbMsg.classList.add("hidden");
      fbMsg.className = "font-sans text-sm text-center mt-3 hidden";
      window.clearTimeout(fbTimer);

      const mensaje = fbTextarea?.value;
      // Disable synchronously before the first await so a double-click can't fire twice
      if (fbBtn) {
        fbBtn.disabled = true;
        fbBtn.textContent = messages.feedbackSending;
      }

      var { data: { session } } = await supabase!.auth.getSession();
      if (!session) {
        fbMsg.textContent = messages.feedbackNeedLogin;
        fbMsg.className = "font-sans text-sm text-center text-triba-red mt-3";
        fbMsg.classList.remove("hidden");
        if (fbBtn) {
          fbBtn.disabled = false;
          fbBtn.textContent = messages.feedbackSubmit;
        }
        return;
      }

      try {
        const res = await fetch("/api/feedback", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Authorization: "Bearer " + session.access_token,
          },
          body: JSON.stringify({ mensaje }),
        });

        const data = await res.json().catch(() => ({}));

        if (res.status === 429) {
          fbMsg.textContent = data.error || messages.feedbackWait;
          fbMsg.className = "font-sans text-sm text-center text-triba-red mt-3";
        } else if (!res.ok) {
          fbMsg.textContent = data.error || messages.feedbackError;
          fbMsg.className = "font-sans text-sm text-center text-triba-red mt-3";
        } else {
          fbMsg.textContent = messages.feedbackThanks;
          fbMsg.className = "font-sans text-sm text-center text-triba-red mt-3";
          if (fbTextarea) fbTextarea.value = "";
          updateCounter();
          window.clearTimeout(fbTimer);
          fbTimer = window.setTimeout(() => {
            fbMsg.classList.add("hidden");
          }, 3000);
        }
      } catch (err) {
        fbMsg.textContent = messages.feedbackConn;
        fbMsg.className = "font-sans text-sm text-center text-triba-red mt-3";
      } finally {
        if (fbBtn) {
          fbBtn.disabled = false;
          fbBtn.textContent = messages.feedbackSubmit;
        }
        fbMsg.classList.remove("hidden");
      }
    });
  }

  // Banner dismiss
  document.querySelectorAll("[data-dismiss-banner]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const banner = btn.closest("[data-banner]") as HTMLElement | null;
      if (banner) banner.style.display = "none";
    });
  });

  }

  onPageCycle(setup);
</script>