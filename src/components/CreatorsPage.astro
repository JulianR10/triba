---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import Input from "../components/Input.astro";
import PatchTitle from "../components/PatchTitle.astro";
import { t, type Locale } from "../i18n/ui";

const { lang = "es" } = Astro.props as { lang?: Locale };
const dict = t(lang);
const canonical = lang === "en" ? "/en/triba-creators" : "/triba-creators";

const formMessages = {
  sending: dict.creators.sending,
  success: dict.creators.success,
  error: dict.creators.error,
  networkError: dict.creators.networkError,
  submit: dict.creators.submit,
};
---

<Layout title={dict.creators.title} description={dict.creators.description} canonical={canonical} lang={lang} navLogoAlways>
  <section class="page-shell page-gutter bg-triba-bone">
    <div class="max-w-6xl mx-auto">

      <div class="flex flex-col gap-3 mb-8 pt-8 md:pt-12 reveal-text" data-reveal>
        <PatchTitle content={dict.creators.patchTitle} tag="h1" class="text-4xl md:text-5xl text-triba-brown" />
      </div>

      <div class="flex flex-col md:flex-row gap-8 md:gap-12 items-center mb-12 reveal-stagger" data-reveal>
        <div class="w-full md:w-[42%] shrink-0">
          <div class="w-[80%] mx-auto">
            <img src="/post-triba-creators.webp" alt={dict.creators.imgAlt} class="w-full h-auto rounded-xl object-cover transition-transform duration-500 hover:scale-[1.03]" />
          </div>
        </div>
        <div class="flex-1 text-center md:text-left md:max-w-[44%]">
          {
            dict.creators.paragraphs.map((p) => (
              <p class="font-sans text-base text-triba-brown leading-relaxed mb-4">{p}</p>
            ))
          }
        </div>
      </div>

      <div class="bg-triba-cream rounded-xl border-2 border-triba-black p-6 md:p-10 max-w-2xl mx-auto reveal" data-reveal>
        <h2 class="font-heading text-lg uppercase tracking-wider text-triba-brown mb-6 text-center">{dict.creators.formTitle}</h2>
        <form class="space-y-5" id="creators-form" data-messages={JSON.stringify(formMessages)}>
          <Input label={dict.creators.name} name="nombre" required />
          <Input label={dict.creators.email} name="email" type="email" required />
          <Input label={dict.creators.country} name="pais" required />
          <div>
            <span class="block font-heading text-xs uppercase tracking-wider text-triba-brown mb-2">{dict.creators.contribution}</span>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              {dict.creators.areas.map((area) => (
                <label class="flex items-center gap-2 font-sans text-base text-triba-brown cursor-pointer">
                  <input type="checkbox" name="area" value={area} class="accent-triba-red" />
                  {area}
                </label>
              ))}
            </div>
          </div>
          <Input label={dict.creators.proposal} name="propuesta" isTextarea required />
          <Input label={dict.creators.work} name="trabajo" type="url" placeholder="https://..." />
          <p id="creators-msg" class="font-sans text-base text-center hidden"></p>
          <Button variant="primary" fullWidth type="submit">{dict.creators.submit}</Button>
        </form>
      </div>

    </div>
  </section>
</Layout>

  <script>
  import { onPageCycle } from "../lib/onPageCycle";
  function setup() {
    const form = document.getElementById("creators-form") as HTMLFormElement;
    const msg = document.getElementById("creators-msg")!;

    if (!form) return;

    const messages = { sending: "Enviando...", success: "¡Gracias por postularte! Te vamos a contactar pronto.", error: "Error al enviar. Intentalo de nuevo.", networkError: "Error de conexión. Intentalo de nuevo.", submit: "Enviar postulación" };
    const raw = form.dataset.messages;
    if (raw) {
      try { Object.assign(messages, JSON.parse(raw)); } catch { /* keep defaults */ }
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      msg.classList.add("hidden");

      const submitBtn = form.querySelector("button[type=submit]") as HTMLButtonElement | null;
      // Disable synchronously before the first await so a double-click can't fire twice
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = messages.sending;
      }

      try {
        const data = new FormData(form);
        const areas = Array.from(form.querySelectorAll("[name=area]:checked")).map(cb => (cb as HTMLInputElement).value);
        const toStr = (v: FormDataEntryValue | null) => (typeof v === "string" ? v : "");
        const trabajo = data.get("trabajo");

        const res = await fetch("/api/creators", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            nombre: toStr(data.get("nombre")),
            email: toStr(data.get("email")),
            pais: toStr(data.get("pais")),
            areas,
            propuesta: toStr(data.get("propuesta")),
            trabajo_url: typeof trabajo === "string" && trabajo ? trabajo : null,
          }),
        });

        const dataRes = await res.json().catch(() => ({}));

        if (res.ok) {
          msg.textContent = messages.success;
          msg.className = "font-sans text-sm text-center text-triba-green";
          form.reset();
        } else {
          msg.textContent = dataRes.error || messages.error;
          msg.className = "font-sans text-sm text-center text-triba-red";
        }
      } catch (err) {
        msg.textContent = messages.networkError;
        msg.className = "font-sans text-sm text-center text-triba-red";
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = messages.submit;
        }
        msg.classList.remove("hidden");
      }
    });
  }

  onPageCycle(setup);
</script>