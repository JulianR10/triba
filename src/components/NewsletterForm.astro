---
import Button from "./Button.astro";
---

<form class="flex flex-col sm:flex-row gap-3 items-center" id="newsletter-form">
  <div class="flex-1 w-full flex items-center gap-3">
    <input
      type="email"
      name="email"
      placeholder="tu email"
      required
      class="flex-1 px-4 py-3 border-2 border-triba-black bg-white text-triba-brown font-sans text-sm placeholder:text-triba-brown/50 focus:outline-none focus:ring-2 focus:ring-triba-red/30 rounded-md"
    />
    <div id="newsletter-msg" class="hidden font-sans text-sm text-triba-red whitespace-nowrap"></div>
  </div>
  <Button variant="primary" class="shrink-0" type="submit">Suscribirme</Button>
</form>

<script>
  import { setupNewsletterForm } from "../scripts/newsletter-handler";

  document.addEventListener("astro:page-load", () => {
    const form = document.getElementById("newsletter-form") as HTMLFormElement | null;
    const msg = document.getElementById("newsletter-msg");
    if (form && msg) setupNewsletterForm(form, msg);
  });
</script>
