---
import FlipCover from "./FlipCover.astro";
import type { Locale } from "../i18n/ui";

export interface Props {
  number: string;
  title: string;
  description: string;
  image: string;
  flipColor?: string;
  backTextClass?: string;
  lang?: Locale;
}

const { number, title, description, image, flipColor, backTextClass, lang } = Astro.props;
---

<div class="flex flex-col gap-4 items-center text-center">
  <div class="w-[90%]">
    <FlipCover image={image} alt={`Triba Tomo ${number}`} flipColor={flipColor} backTextClass={backTextClass} rounded="rounded-lg" textSize="text-base" pad="p-6" lang={lang} />
  </div>
  <h2 class="font-heading text-lg uppercase tracking-wide text-triba-black font-bold">#{number} {title}</h2>
  <p class="font-sans text-triba-brown text-base leading-relaxed line-clamp-3">{description}</p>
</div>
