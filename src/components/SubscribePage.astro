---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import CheckoutButton from "../components/CheckoutButton.astro";
import { plans } from "../lib/pricing";
import PatchTitle from "../components/PatchTitle.astro";
import { getCheckoutOutcome } from "../lib/checkout-status";
import { t, type Locale } from "../i18n/ui";
import { localizePath } from "../i18n/locale";
import { COUNTRIES } from "../lib/countries";
import { MAIL_CLUB_EUROPE_ISO, MAIL_CLUB_TERMS_VERSION } from "../lib/mail-club";

const { lang = "es" } = Astro.props as { lang?: Locale };
const dict = t(lang);
const canonical = lang === "en" ? "/en/suscribirme" : "/suscribirme";

const faqs = dict.subscribe.faqs;

const checkoutOutcome = getCheckoutOutcome(Astro.url.searchParams);

const sortedCountries = [...COUNTRIES].sort((a, b) =>
  (lang === "en" ? a.en : a.es).localeCompare(lang === "en" ? b.en : b.es, lang === "en" ? "en" : "es"),
);
const europeIsoList = [...MAIL_CLUB_EUROPE_ISO];
const mailClubMessages = {
  processing: dict.mailClub.processing,
  needLogin: dict.mailClub.needLogin,
  error: dict.mailClub.error,
  networkError: dict.mailClub.networkError,
};
const mailClubPrices = {
  eur: dict.mailClub.eurPrice,
  usd: dict.mailClub.usdPrice,
  ars: dict.mailClub.arsPrice,
  period: dict.subscribe.period,
  card: dict.mailClub.cardLabel,
  mp: dict.mailClub.mpLabel,
  eurNote: dict.mailClub.eurNote,
  usdNote: dict.mailClub.usdNote,
  arsNote: dict.mailClub.arsNote,
};
const mailClubLoginHref =
  localizePath("/iniciar-sesion", lang) +
  "?signup=true&redirect=" +
  encodeURIComponent((lang === "en" ? "/en/suscribirme" : "/suscribirme") + "?plan=mail_club");
const mailClubTermsHref = localizePath("/terminos", lang) + "#mail-club";
---

<style>
  /* Hallmark · macrostructure: Split Studio (variant: hero-plan + secondary-plan diptych) · genre: editorial · theme: triba-brand (locked tokens)
   * pre-emit critique: P5 H4 E5 S4 R5 V5 · logic/ids/copy/routes unchanged · digital secondary, Mail Club focus */
  details[data-faq] .faq-content {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 1s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  details[data-faq][open] .faq-content {
    grid-template-rows: 1fr;
  }
  details[data-faq] .faq-content-inner {
    min-height: 0;
    overflow: hidden;
  }
</style>

<Layout title={dict.subscribe.title} description={dict.subscribe.description} canonical={canonical} lang={lang} navLogoAlways>
  <section class="page-shell page-gutter bg-triba-bone">
      <div class="max-w-6xl mx-auto">

      {checkoutOutcome === "canceled" && (
        <div data-banner="checkout-canceled" class="mb-8 p-4 bg-triba-red/10 border-2 border-triba-red rounded-xl flex items-start justify-between gap-3 reveal" data-reveal>
          <p class="font-sans text-base text-triba-brown">{dict.subscribe.checkoutCanceled}</p>
          <button type="button" data-dismiss-banner class="shrink-0 text-triba-brown hover:text-triba-red text-xl leading-none" aria-label={dict.subscribe.close}>×</button>
        </div>
      )}

      {checkoutOutcome === "pending" && (
        <div data-banner="checkout-pending" class="mb-8 p-4 bg-triba-blue/10 border-2 border-triba-blue rounded-xl flex items-start justify-between gap-3 reveal" data-reveal>
          <p class="font-sans text-base text-triba-brown">{dict.subscribe.checkoutPending}</p>
          <button type="button" data-dismiss-banner class="shrink-0 text-triba-brown hover:text-triba-red text-xl leading-none" aria-label={dict.subscribe.close}>×</button>
        </div>
      )}

      <div class="max-w-3xl mb-12 md:mb-16 pt-8 md:pt-12 reveal-text" data-reveal>
        <PatchTitle content={dict.subscribe.patchTitle} tag="h1" centered={false} class="text-5xl md:text-6xl text-triba-brown" />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] gap-10 md:gap-8 items-start">
        <!-- Plan secundario: Suscripción Triba digital -->
        <div class="order-2">
          <div class="bg-triba-white rounded-xl border-2 border-triba-black p-6 md:p-8 flex flex-col h-full">
            <h3 class="font-heading text-lg font-bold text-triba-brown mb-4 uppercase tracking-wider">{dict.subscribe.subTitle}</h3>
            <ul class="space-y-3 font-sans text-base text-triba-brown mb-6 text-left">
              {
                dict.subscribe.bullets.map((b) => (
                  <li class="flex justify-start gap-2">✦ {b}</li>
                ))
              }
            </ul>
            <p class="font-sans text-xs text-triba-brown/70 mb-6 leading-relaxed text-balance">{dict.subscribe.accessNote}</p>

            <div class="bg-triba-cream rounded-xl border-2 border-triba-black p-6 md:p-8 mt-auto">
              <div class="flex border-2 border-triba-black rounded-full overflow-hidden mb-6 w-full max-w-xs" id="currency-segments">
                {plans.map((p, i) => (
                  <button
                    data-currency={p.moneda}
                    class={"flex-1 py-5 font-heading text-sm uppercase tracking-wider transition-all " + (i < plans.length - 1 ? "border-r-2 border-triba-black " : "") + (p.moneda === "EUR" ? "bg-triba-red text-triba-white" : "bg-triba-white text-triba-brown hover:bg-triba-cream")}
                  >
                    {p.moneda}
                  </button>
                ))}
              </div>

              {plans.map((p) => (
                <div data-plan={p.moneda} class={p.moneda === "EUR" ? "" : "hidden"}>
                  <p class="font-heading text-4xl md:text-5xl font-bold text-triba-red mb-1">{p.simbolo}{p.precio}</p>
                  <p class="font-sans text-base text-triba-brown/60 mb-8">{dict.subscribe.period}</p>

                  <div class="space-y-3 mb-6">
                    {p.moneda !== "ARS" && <CheckoutButton provider="stripe" currency={p.moneda} variant="default" fullWidth lang={lang} />}
                    {p.moneda === "ARS" && <CheckoutButton provider="mercadopago" currency={p.moneda} variant="default" fullWidth lang={lang} />}
                  </div>

                  <p class="font-sans text-[11px] text-triba-brown/50">{dict.subscribe.monthlyNote}</p>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Plan héroe: Triba Mail Club -->
        <div class="order-1 h-full flex flex-col justify-center">
          <div class="bg-triba-pink rounded-xl border-2 border-triba-black p-6 md:p-10 mb-8">
            <div class="inline-block bg-triba-green text-triba-brown font-heading text-sm uppercase tracking-wider px-6 py-2 rounded-full border border-triba-black mb-6">{dict.mailClub.tag}</div>
            <h3 class="font-heading text-2xl md:text-3xl font-bold text-triba-brown mb-6 uppercase tracking-wider">{dict.mailClub.title}</h3>
            <ul class="space-y-2 font-sans text-base text-triba-brown text-left mb-4">
              {
                dict.mailClub.bullets.map((b) => (
                  <li class="flex justify-start gap-2">✦ {b}</li>
                ))
              }
            </ul>
            <p class="font-sans text-xs text-triba-brown/70 mb-6 leading-relaxed text-balance">{dict.mailClub.cutoffNote}</p>

            <div class="bg-triba-white rounded-xl border-2 border-triba-black p-6 md:p-8">
              <p id="mailclub-price" class="font-heading text-5xl md:text-6xl font-bold text-triba-red mb-1">—</p>
              <p class="font-sans text-sm text-triba-brown/60 mb-1"><span id="mailclub-provider"></span></p>
              <p id="mailclub-zone-note" class="font-sans text-xs text-triba-brown/60 mb-6"></p>

              <div id="mailclub-login-box" class="hidden text-center space-y-4 py-2">
                <p class="font-sans text-sm text-triba-brown/80">{dict.mailClub.loginTitle}</p>
                <Button variant="primary" size="md" href={mailClubLoginHref}>{dict.mailClub.loginButton}</Button>
              </div>
              <form class="space-y-3 text-left hidden" id="mailclub-form"
                data-messages={JSON.stringify(mailClubMessages)}
                data-prices={JSON.stringify(mailClubPrices)}
                data-europe={JSON.stringify(europeIsoList)}
                data-terms-version={MAIL_CLUB_TERMS_VERSION}>
                <p class="font-heading text-sm uppercase tracking-wider text-triba-brown text-center mb-2">{dict.mailClub.formTitle}</p>
                <label class="block">
                  <span class="font-sans text-xs text-triba-brown/70">{dict.mailClub.recipient}</span>
                  <input name="recipient_name" required maxlength="120" autocomplete="name"
                    class="mt-1 w-full px-4 py-3 rounded-button border-2 border-triba-black bg-triba-white font-sans text-sm text-triba-brown outline-none focus:border-triba-red transition-colors" />
                </label>
                <label class="block">
                  <span class="font-sans text-xs text-triba-brown/70">{dict.mailClub.country}</span>
                  <select name="country_iso" id="mailclub-country" required
                    class="mt-1 w-full px-4 py-3 rounded-button border-2 border-triba-black bg-triba-white font-sans text-sm text-triba-brown outline-none focus:border-triba-red transition-colors">
                    <option value="">{dict.mailClub.countryPlaceholder}</option>
                    {sortedCountries.map((c) => (
                      <option value={c.iso}>{lang === "en" ? c.en : c.es}</option>
                    ))}
                  </select>
                </label>
                <div class="grid grid-cols-2 gap-3">
                  <label class="block">
                    <span class="font-sans text-xs text-triba-brown/70">{dict.mailClub.region}</span>
                    <input name="region" maxlength="120" autocomplete="address-level1"
                      class="mt-1 w-full px-4 py-3 rounded-button border-2 border-triba-black bg-triba-white font-sans text-sm text-triba-brown outline-none focus:border-triba-red transition-colors" />
                  </label>
                  <label class="block">
                    <span class="font-sans text-xs text-triba-brown/70">{dict.mailClub.city}</span>
                    <input name="city" required maxlength="120" autocomplete="address-level2"
                      class="mt-1 w-full px-4 py-3 rounded-button border-2 border-triba-black bg-triba-white font-sans text-sm text-triba-brown outline-none focus:border-triba-red transition-colors" />
                  </label>
                </div>
                <label class="block">
                  <span class="font-sans text-xs text-triba-brown/70">{dict.mailClub.postal}</span>
                  <input name="postal_code" maxlength="30" autocomplete="postal-code"
                    class="mt-1 w-full px-4 py-3 rounded-button border-2 border-triba-black bg-triba-white font-sans text-sm text-triba-brown outline-none focus:border-triba-red transition-colors" />
                </label>
                <label class="block">
                  <span class="font-sans text-xs text-triba-brown/70">{dict.mailClub.street}</span>
                  <input name="street_address" required maxlength="240" autocomplete="street-address"
                    class="mt-1 w-full px-4 py-3 rounded-button border-2 border-triba-black bg-triba-white font-sans text-sm text-triba-brown outline-none focus:border-triba-red transition-colors" />
                </label>
                <label class="block">
                  <span class="font-sans text-xs text-triba-brown/70">{dict.mailClub.extra}</span>
                  <input name="address_extra" maxlength="240"
                    class="mt-1 w-full px-4 py-3 rounded-button border-2 border-triba-black bg-triba-white font-sans text-sm text-triba-brown outline-none focus:border-triba-red transition-colors" />
                </label>
                <label class="flex items-start gap-2 pt-1">
                  <input type="checkbox" name="terms_accepted" required class="mt-1 accent-[#E91A39]" />
                  <span class="font-sans text-xs text-triba-brown/80">
                    {dict.mailClub.terms}
                    {" "}<a href={mailClubTermsHref} class="text-triba-red hover:underline">{dict.mailClub.termsLink}</a>
                  </span>
                </label>
                <p id="mailclub-msg" class="hidden font-sans text-xs text-triba-red text-center"></p>
                <Button variant="default" size="md" type="submit">{dict.mailClub.button}</Button>
              </form>

              <p class="font-sans text-[11px] text-triba-brown/50 mt-4">{dict.mailClub.monthlyNote}</p>
              <a href={localizePath("/mail-club", lang)} class="inline-block mt-2 font-sans text-xs text-triba-red hover:underline">{dict.mailClub.howItWorks}</a>
            </div>
          </div>

          <div class="text-center">
            <p class="font-serif italic text-base md:text-lg text-triba-brown/70 max-w-lg mx-auto text-balance">
              {dict.subscribe.socialProof}
            </p>
            <p class="font-heading text-xs uppercase tracking-wider text-triba-red mt-2">{dict.subscribe.team}</p>
          </div>

          <!-- FAQ -->
          <div class="mt-12">
            <h2 class="font-heading text-2xl md:text-3xl uppercase tracking-wide text-triba-brown mb-8">{dict.subscribe.faqTitle}</h2>
            <div class="space-y-4">
              {faqs.map((faq) => (
                <details data-faq class="bg-triba-cream rounded-xl border-2 border-triba-black overflow-hidden group transition-shadow duration-300 hover:shadow-md">
                  <summary class="px-5 py-4 font-heading text-sm font-medium uppercase tracking-wider text-triba-brown cursor-pointer list-none flex items-center justify-between">
                    {faq.q}
                    <span class="text-triba-red text-lg transition-transform duration-300 group-open:rotate-45 shrink-0 ml-3">+</span>
                  </summary>
                  <div class="faq-content">
                    <div class="faq-content-inner px-5 pb-4 font-sans text-base text-triba-brown leading-relaxed">
                      {faq.a}
                    </div>
                  </div>
                </details>
              ))}
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>
</Layout>

<script>
  import { supabase } from "../lib/supabase";
  import { getCheckoutIntent, clearCheckoutIntent } from "../lib/checkout-intent";
  import { onPageCycle } from "../lib/onPageCycle";

  function selectCurrency(currency: string) {
    var tabs = document.querySelectorAll("[data-currency]");
    var planEls = document.querySelectorAll("[data-plan]") as NodeListOf<HTMLElement>;

    tabs.forEach(function (t) {
      t.classList.remove("bg-triba-red", "text-triba-white");
      t.classList.add("bg-triba-white", "text-triba-brown");
    });
    var activeTab = document.querySelector('[data-currency="' + currency + '"]');
    if (activeTab) {
      activeTab.classList.remove("bg-triba-white", "text-triba-brown");
      activeTab.classList.add("bg-triba-red", "text-triba-white");
    }
    planEls.forEach(function (p) {
      p.classList.toggle("hidden", p.dataset.plan !== currency);
    });
  }

  async function flushPendingCheckout() {
    var pending = getCheckoutIntent();
    if (!pending) return;

    if (supabase) {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) return;
    }

    var currency = pending.currency;
    selectCurrency(currency);

    var btn = document.querySelector(
      'button[data-provider="' + pending.provider + '"][data-currency="' + currency + '"]'
    ) as HTMLButtonElement | null;
    // P8: clear only once we can actually act on the intent — clearing before
    // left the checkout lost with no recovery when the button didn't match.
    if (!btn) return;

    clearCheckoutIntent();

    btn.scrollIntoView({ behavior: "smooth", block: "center" });
    setTimeout(function () { btn!.click(); }, 400);
  }

  function setup() {
    var tabs = document.querySelectorAll("[data-currency]") as NodeListOf<HTMLElement>;
    var urlParams = new URLSearchParams(window.location.search);
    var urlCurrency = urlParams.get("currency");
    if (urlCurrency) selectCurrency(urlCurrency);
    if (urlParams.get("plan") === "mail_club") {
      var mcForm = document.getElementById("mailclub-form");
      if (mcForm) mcForm.scrollIntoView({ behavior: "smooth", block: "center" });
    }

    tabs.forEach(function (btn) {
      btn.addEventListener("click", function () {
        selectCurrency(btn.dataset.currency!);
      });
    });

    document.querySelectorAll("[data-dismiss-banner]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var banner = btn.closest("[data-banner]") as HTMLElement;
        if (banner) banner.style.display = "none";
      });
    });

    var faqDetails = document.querySelectorAll<HTMLDetailsElement>("details[data-faq]");
    faqDetails.forEach(function (detail) {
      detail.addEventListener("toggle", function () {
        if (detail.open) {
          faqDetails.forEach(function (other) {
            if (other !== detail) other.open = false;
          });
        }
      });
    });

    setupMailClubForm();

    flushPendingCheckout();
  }

  function setupMailClubForm() {
    var form = document.getElementById("mailclub-form") as HTMLFormElement | null;
    if (!form) return;

    // Sesión primero: sin cuenta no se muestra el formulario (la dirección
    // no se guarda en localStorage y no se pierde lo cargado).
    var loginBox = document.getElementById("mailclub-login-box");
    function revealForSession(hasSession: boolean) {
      if (hasSession) {
        form!.classList.remove("hidden");
        if (loginBox) loginBox.classList.add("hidden");
      } else {
        form!.classList.add("hidden");
        if (loginBox) loginBox.classList.remove("hidden");
      }
    }
    if (supabase) {
      supabase.auth.getSession().then(function ({ data }: any) {
        revealForSession(!!data.session);
      });
    }

    var messages = { processing: "Procesando...", needLogin: "", error: "Error", networkError: "Error" };
    try { Object.assign(messages, JSON.parse(form.dataset.messages || "{}")); } catch { /* keep defaults */ }
    var prices: Record<string, string> = {};
    try { prices = JSON.parse(form.dataset.prices || "{}"); } catch { /* keep defaults */ }
    var europe: string[] = [];
    try { europe = JSON.parse(form.dataset.europe || "[]"); } catch { /* keep defaults */ }
    var termsVersion = form.dataset.termsVersion || "v1";

    var countrySel = document.getElementById("mailclub-country") as HTMLSelectElement | null;
    var priceEl = document.getElementById("mailclub-price");
    var providerEl = document.getElementById("mailclub-provider");
    var noteEl = document.getElementById("mailclub-zone-note");
    var msgEl = document.getElementById("mailclub-msg");
    var submitBtn = form.querySelector("button[type=submit]") as HTMLButtonElement | null;
    var originalBtnText = submitBtn ? submitBtn.textContent : "";

    function showMsg(text: string) {
      if (!msgEl) return;
      msgEl.textContent = text;
      msgEl.classList.remove("hidden");
    }
    function hideMsg() {
      if (!msgEl) return;
      msgEl.textContent = "";
      msgEl.classList.add("hidden");
    }

    function refreshPrice() {
      var iso = countrySel ? countrySel.value : "";
      if (!iso) {
        if (priceEl) priceEl.textContent = "—";
        if (providerEl) providerEl.textContent = "";
        if (noteEl) noteEl.textContent = "";
        return;
      }
      if (iso === "AR") {
        if (priceEl) priceEl.textContent = (prices.ars || "") + (prices.period || "");
        if (providerEl) providerEl.textContent = prices.mp || "";
        if (noteEl) noteEl.textContent = prices.arsNote || "";
      } else if (europe.indexOf(iso) >= 0) {
        if (priceEl) priceEl.textContent = (prices.eur || "") + (prices.period || "");
        if (providerEl) providerEl.textContent = prices.card || "";
        if (noteEl) noteEl.textContent = prices.eurNote || "";
      } else {
        if (priceEl) priceEl.textContent = (prices.usd || "") + (prices.period || "");
        if (providerEl) providerEl.textContent = prices.card || "";
        if (noteEl) noteEl.textContent = prices.usdNote || "";
      }
    }

    if (countrySel) countrySel.addEventListener("change", refreshPrice);
    refreshPrice();

    form.addEventListener("submit", async function (e) {
      e.preventDefault();
      hideMsg();
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = messages.processing;
      }

      try {
        if (!supabase) throw new Error(messages.error);
        var { data: { session } } = await supabase.auth.getSession();
        if (!session) {
          // Sin sesión: ir a login y volver (la dirección NO se guarda en localStorage).
          var isEn = window.location.pathname.startsWith("/en/");
          var loginPath = isEn ? "/en/iniciar-sesion" : "/iniciar-sesion";
          var redirect = encodeURIComponent(window.location.pathname + "?plan=mail_club");
          window.location.href = loginPath + "?signup=true&redirect=" + redirect;
          return;
        }

        var fd = new FormData(form!);
        var payload = {
          plan: "mail_club",
          recipient_name: String(fd.get("recipient_name") || ""),
          country_iso: String(fd.get("country_iso") || ""),
          region: String(fd.get("region") || ""),
          city: String(fd.get("city") || ""),
          postal_code: String(fd.get("postal_code") || ""),
          street_address: String(fd.get("street_address") || ""),
          address_extra: String(fd.get("address_extra") || ""),
          terms_accepted: fd.get("terms_accepted") === "on",
          terms_version: termsVersion,
        };

        var res = await fetch("/api/create-checkout", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Authorization: "Bearer " + session.access_token,
          },
          body: JSON.stringify(payload),
        });
        var data = await res.json().catch(function () { return {}; });
        if (!res.ok) throw new Error(data.error || messages.error);
        if (data.url) {
          window.location.href = data.url;
          return;
        }
        throw new Error(data.error || messages.error);
      } catch (err: any) {
        showMsg(err && err.message ? err.message : messages.networkError);
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = originalBtnText;
        }
      }
    });
  }

  onPageCycle(setup);
</script>