---
import Input from "../Input.astro";
import Button from "../Button.astro";
import { isStorageConfigured } from "../../lib/storage";
import type { AdminEditionRow } from "../../lib/admin/editions";

interface Props {
  mode: "create" | "edit";
  edition?: AdminEditionRow | null;
}

const { mode, edition } = Astro.props;
const storageReady = isStorageConfigured();
const formId = `edition-form-${mode}`;
const formMsgId = "form-msg";
const initialKind = edition?.kind ?? "magazine";
const versionsByLang = new Map(
  (edition?.versions ?? []).map((v) => [v.language, v])
);
const esVersion = versionsByLang.get("es");
const enVersion = versionsByLang.get("en");
---

<form id={formId} data-edition-id={edition?.id ?? ""} data-mode={mode} class="space-y-6">
  <fieldset>
    <legend class="block font-heading text-xs uppercase tracking-wider text-triba-brown mb-2">Tipo de contenido</legend>
    <div class="grid sm:grid-cols-2 gap-3">
      <label
        for="kind-magazine"
        class="flex items-center gap-3 p-4 rounded-xl border-2 cursor-pointer hover:border-triba-black transition-colors"
      >
        <input
          type="radio"
          id="kind-magazine"
          name="kind"
          value="magazine"
          checked={initialKind === "magazine"}
          class="accent-triba-red w-5 h-5"
        />
        <div>
          <p class="font-heading text-sm uppercase tracking-wider text-triba-brown">Para suscriptoras</p>
          <p class="font-sans text-xs text-triba-brown/60">Un ejemplar en dos idiomas: portada + PDF en español y (opcional) en inglés. Acceso restringido.</p>
        </div>
      </label>
      <label
        for="kind-free"
        class="flex items-center gap-3 p-4 rounded-xl border-2 cursor-pointer hover:border-triba-black transition-colors"
      >
        <input
          type="radio"
          id="kind-free"
          name="kind"
          value="free"
          checked={initialKind === "free"}
          class="accent-triba-green"
        />
        <div>
          <p class="font-heading text-sm uppercase tracking-wider text-triba-brown">Artículo gratis universal</p>
          <p class="font-sans text-xs text-triba-brown/60">PDF público que se muestra en /revista, sin acceso restringido.</p>
        </div>
      </label>
    </div>
  </fieldset>

  <div id="issue-fields" class="grid md:grid-cols-2 gap-4">
    <Input
      label="Número de edición"
      name="edition_number"
      type="number"
      required
      minlength={1}
      placeholder="1"
      value={edition?.edition_number?.toString() ?? ""}
      validationMsg="Ingresá un número entero positivo"
    />
    <label class="flex items-center gap-3 p-4 rounded-xl border-2 border-triba-black/20 bg-triba-white cursor-pointer hover:border-triba-black">
      <input
        type="checkbox"
        name="featured"
        value="true"
        checked={!!edition?.featured}
        class="w-5 h-5 accent-triba-red"
      />
      <div>
        <p class="font-heading text-sm uppercase tracking-wider text-triba-brown">Ejemplar destacado</p>
        <p class="font-sans text-xs text-triba-brown/60">Solo puede haber uno a la vez. Quita el destaque del anterior automáticamente.</p>
      </div>
    </label>
  </div>

  <!-- ===== VERSIÓN EN ESPAÑOL ===== -->
  <div data-lang-section data-lang="es">
    <div class="flex items-center gap-3 mb-3">
      <p class="font-heading text-sm uppercase tracking-wider text-triba-brown">Versión en español</p>
      <span class="inline-block px-2 py-0.5 rounded-full bg-triba-red text-triba-white font-heading text-[10px] uppercase tracking-wider">Obligatorio</span>
    </div>
    <div class="space-y-5 p-5 rounded-xl border-2 border-triba-black bg-triba-white">
      <div data-badge-field>
        <label for="es_badge" class="block font-heading text-xs uppercase tracking-wider text-triba-brown mb-1">Badge (opcional)</label>
        <input
          id="es_badge"
          name="es_badge"
          type="text"
          placeholder="Última edición"
          value={esVersion?.badge ?? ""}
          class="w-full px-4 py-3 rounded-button border-2 border-triba-black bg-triba-white font-sans text-sm text-triba-brown outline-none focus:border-triba-red transition-colors"
        />
      </div>

      <div>
        <label for="es_title" class="block font-heading text-xs uppercase tracking-wider text-triba-brown mb-1">Título</label>
        <input
          id="es_title"
          name="es_title"
          type="text"
          required
          placeholder="Tomo 1 — Identidades"
          value={esVersion?.title ?? ""}
          class="w-full px-4 py-3 rounded-button border-2 border-triba-black bg-triba-white font-sans text-sm text-triba-brown outline-none focus:border-triba-red transition-colors"
        />
      </div>

      <div data-description-field>
        <label for="es_description" class="block font-heading text-xs uppercase tracking-wider text-triba-brown mb-1">Descripción</label>
        <textarea
          id="es_description"
          name="es_description"
          rows="4"
          required
          placeholder="Resumen del ejemplar. Se muestra en la home y en la portada del PDF."
          class="w-full px-4 py-3 rounded-button border-2 border-triba-black bg-triba-white font-sans text-sm text-triba-brown outline-none focus:border-triba-red transition-colors resize-none"
        >{esVersion?.description ?? ""}</textarea>
      </div>

      <div data-cover-field>
        <p class="block font-heading text-xs uppercase tracking-wider text-triba-brown mb-2">Portada (imagen)</p>
        <div class="border-2 border-dashed border-triba-black/30 rounded-xl p-4 bg-triba-bone">
          {esVersion?.cover_url && (
            <img id="es-cover-preview" src={esVersion.cover_url} alt="Portada actual en español" class="w-32 h-auto mx-auto mb-3 rounded border border-triba-black/20" />
          )}
          <input
            type="file"
            name="es_cover_file"
            accept="image/jpeg,image/png,image/webp,image/avif"
            class="font-sans text-xs w-full"
          />
          <p class="font-sans text-xs text-triba-brown/60 mt-2">JPG/PNG/WebP/AVIF, máx 5 MB. Si no subís archivo nuevo, se conserva la portada actual.</p>
        </div>
      </div>

      <div>
        <p class="block font-heading text-xs uppercase tracking-wider text-triba-brown mb-2">PDF (español)</p>
        <div class="border-2 border-dashed border-triba-black/30 rounded-xl p-4 bg-triba-bone">
          {esVersion?.pdf_url && (
            <p class="font-sans text-xs text-triba-brown/70 mb-2">PDF actual: <a href={esVersion.pdf_url} class="text-triba-red hover:underline" target="_blank" rel="noopener">ver</a></p>
          )}
          <input
            type="file"
            name="es_pdf_file"
            accept="application/pdf"
            class="font-sans text-xs w-full"
          />
          <p class="font-sans text-xs text-triba-brown/60 mt-2">PDF, máx 50 MB. Si no subís archivo nuevo, se conserva el actual.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- ===== VERSIÓN EN INGLÉS (opcional) ===== -->
  <div data-lang-section data-lang="en">
    <div class="flex items-center gap-3 mb-3">
      <p class="font-heading text-sm uppercase tracking-wider text-triba-brown">Version in English</p>
      <span class="inline-block px-2 py-0.5 rounded-full bg-triba-green text-triba-brown font-heading text-[10px] uppercase tracking-wider">Opcional</span>
    </div>
    <p class="font-sans text-xs text-triba-brown/60 mb-3">
      Si el inglés todavía no está listo, dejá la sección vacía: la revista se publica igual y aparece el estado "English coming soon".
    </p>
    <div class="space-y-5 p-5 rounded-xl border-2 border-triba-black/40 bg-triba-bone">
      <div data-badge-field>
        <label for="en_badge" class="block font-heading text-xs uppercase tracking-wider text-triba-brown mb-1">Badge (optional)</label>
        <input
          id="en_badge"
          name="en_badge"
          type="text"
          placeholder="Latest issue"
          value={enVersion?.badge ?? ""}
          class="w-full px-4 py-3 rounded-button border-2 border-triba-black bg-triba-white font-sans text-sm text-triba-brown outline-none focus:border-triba-red transition-colors"
        />
      </div>

      <div>
        <label for="en_title" class="block font-heading text-xs uppercase tracking-wider text-triba-brown mb-1">Title</label>
        <input
          id="en_title"
          name="en_title"
          type="text"
          placeholder="Issue 1 — Identities"
          value={enVersion?.title ?? ""}
          class="w-full px-4 py-3 rounded-button border-2 border-triba-black bg-triba-white font-sans text-sm text-triba-brown outline-none focus:border-triba-red transition-colors"
        />
      </div>

      <div data-description-field>
        <label for="en_description" class="block font-heading text-xs uppercase tracking-wider text-triba-brown mb-1">Description</label>
        <textarea
          id="en_description"
          name="en_description"
          rows="4"
          placeholder="Summary of the issue. Shown on the home page and the PDF cover."
          class="w-full px-4 py-3 rounded-button border-2 border-triba-black bg-triba-white font-sans text-sm text-triba-brown outline-none focus:border-triba-red transition-colors resize-none"
        >{enVersion?.description ?? ""}</textarea>
      </div>

      <div data-cover-field>
        <p class="block font-heading text-xs uppercase tracking-wider text-triba-brown mb-2">Cover (image)</p>
        <div class="border-2 border-dashed border-triba-black/30 rounded-xl p-4 bg-triba-white">
          {enVersion?.cover_url && (
            <img id="en-cover-preview" src={enVersion.cover_url} alt="Current English cover" class="w-32 h-auto mx-auto mb-3 rounded border border-triba-black/20" />
          )}
          <input
            type="file"
            name="en_cover_file"
            accept="image/jpeg,image/png,image/webp,image/avif"
            class="font-sans text-xs w-full"
          />
          <p class="font-sans text-xs text-triba-brown/60 mt-2">JPG/PNG/WebP/AVIF, máx 5 MB.</p>
        </div>
      </div>

      <div>
        <p class="block font-heading text-xs uppercase tracking-wider text-triba-brown mb-2">PDF (English)</p>
        <div class="border-2 border-dashed border-triba-black/30 rounded-xl p-4 bg-triba-white">
          {enVersion?.pdf_url && (
            <p class="font-sans text-xs text-triba-brown/70 mb-2">Current PDF: <a href={enVersion.pdf_url} class="text-triba-red hover:underline" target="_blank" rel="noopener">view</a></p>
          )}
          <input
            type="file"
            name="en_pdf_file"
            accept="application/pdf"
            class="font-sans text-xs w-full"
          />
          <p class="font-sans text-xs text-triba-brown/60 mt-2">PDF, máx 50 MB.</p>
        </div>
      </div>
    </div>
  </div>

  <input type="hidden" name="es_cover_url" value={esVersion?.cover_url ?? ""} />
  <input type="hidden" name="es_pdf_url" value={esVersion?.pdf_url ?? ""} />
  <input type="hidden" name="en_cover_url" value={enVersion?.cover_url ?? ""} />
  <input type="hidden" name="en_pdf_url" value={enVersion?.pdf_url ?? ""} />

  {!storageReady && (
    <p class="font-sans text-xs text-triba-red bg-triba-red/10 border border-triba-red rounded p-3">
      ⚠️ Storage no está configurado. Vas a tener que pegar URLs externas para cover y PDF.
    </p>
  )}

  <div class="flex flex-wrap items-center gap-3 pt-2">
    <Button type="submit" variant="primary">{mode === "create" ? "Crear edición" : "Guardar cambios"}</Button>
    <a href="/admin/ediciones" class="rounded-button bg-triba-bone text-triba-brown border-2 border-triba-black px-6 py-3 font-heading text-xs uppercase tracking-wider hover:scale-[1.02] transition-all">Cancelar</a>
    {mode === "edit" && (
      <button
        type="button"
        id="delete-edition-btn"
        data-edition-id={edition?.id}
        data-edition-number={edition?.edition_number ?? ""}
        class="ml-auto rounded-button bg-transparent text-triba-red border-2 border-triba-red px-6 py-3 font-heading text-xs uppercase tracking-wider hover:bg-triba-red hover:text-triba-white transition-all"
      >
        Eliminar
      </button>
    )}
  </div>

  <p id={formMsgId} class="font-sans text-sm hidden"></p>
</form>

<script>
  import { onPageCycle } from "../../lib/onPageCycle";
  function setupEditionForm() {
    const form = document.querySelector<HTMLFormElement>("form[id^=edition-form-]");
    if (!form) return;
    const msg = document.getElementById("form-msg");
    if (!msg) return;
    const submitBtn = form.querySelector<HTMLButtonElement>("button[type=submit]");
    if (!submitBtn) return;
    const mode = form.dataset.mode;

    if ((form as any)._editionFormBound) return;
    (form as any)._editionFormBound = true;

    const issueFields = document.getElementById("issue-fields");
    const esTitle = form.querySelector<HTMLInputElement>("input[name=es_title]");
    const esDescription = form.querySelector<HTMLTextAreaElement>("textarea[name=es_description]");
    const esPdf = form.querySelector<HTMLInputElement>("input[name=es_pdf_file]");
    const coverFields = form.querySelectorAll<HTMLElement>("[data-cover-field]");
    const descriptionFields = form.querySelectorAll<HTMLElement>("[data-description-field]");
    const badgeFields = form.querySelectorAll<HTMLElement>("[data-badge-field]");

    function syncKind() {
      const kind = form!.querySelector<HTMLInputElement>("input[name=kind]:checked")?.value ?? "magazine";
      const isFree = kind === "free";
      issueFields?.classList.toggle("hidden", isFree);
      coverFields.forEach((el) => el.classList.toggle("hidden", isFree));
      descriptionFields.forEach((el) => el.classList.toggle("hidden", isFree));
      badgeFields.forEach((el) => el.classList.toggle("hidden", isFree));
      if (esTitle) esTitle.required = true;
      if (esDescription) esDescription.required = !isFree;
      if (esPdf) esPdf.required = isFree;
    }
    form.querySelectorAll<HTMLInputElement>("input[name=kind]").forEach((r) => {
      r.addEventListener("change", syncKind);
    });
    syncKind();

    const slots: { lang: "es" | "en"; kind: "cover" | "pdf"; input: HTMLInputElement | null }[] = [
      { lang: "es", kind: "cover", input: form.querySelector<HTMLInputElement>("input[name=es_cover_file]") },
      { lang: "es", kind: "pdf", input: form.querySelector<HTMLInputElement>("input[name=es_pdf_file]") },
      { lang: "en", kind: "cover", input: form.querySelector<HTMLInputElement>("input[name=en_cover_file]") },
      { lang: "en", kind: "pdf", input: form.querySelector<HTMLInputElement>("input[name=en_pdf_file]") },
    ];

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      msg.classList.add("hidden");
      msg.textContent = "";
      msg.className = "font-sans text-sm hidden";

      const fd = new FormData(form);
      submitBtn.disabled = true;
      submitBtn.textContent = mode === "create" ? "Creando..." : "Guardando...";

      const setState = (text: string) => { submitBtn.textContent = text; };
      const uploadedPaths: string[] = [];

      async function cleanupUploaded() {
        if (uploadedPaths.length === 0) return;
        try {
          await fetch("/api/admin/uploads/cleanup", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ paths: uploadedPaths }),
          });
        } catch {}
      }

      try {
        // Upload files FIRST, directly to Supabase Storage (bypasses the Vercel 4.5MB body limit).
        // All-or-nothing: if any upload fails we abort before touching the API.
        const kind = form.querySelector<HTMLInputElement>("input[name=kind]:checked")?.value ?? "magazine";
        const isFree = kind === "free";
        const editionNumber =
          isFree
            ? undefined
            : Number(form.querySelector<HTMLInputElement>("input[name=edition_number]")?.value || 0);

        for (const slot of slots) {
          const file = slot.input?.files?.[0];
          if (!file) continue;
          if (slot.kind === "cover" && isFree) continue;
          setState(`Subiendo ${slot.lang.toUpperCase()} (${slot.kind})...`);
          const { publicUrl, path } = await signAndUpload(slot.kind, file, editionNumber, isFree, slot.lang);
          fd.set(`${slot.lang}_${slot.kind}_url`, publicUrl);
          if (path) uploadedPaths.push(path);
        }
        slots.forEach((slot) => { if (slot.input) fd.delete(slot.input.name); });

        setState(mode === "create" ? "Creando..." : "Guardando...");

        const editionId = form.dataset.editionId;
        const url = mode === "create"
          ? "/api/admin/editions"
          : `/api/admin/editions/${editionId}`;
        const method = mode === "create" ? "POST" : "PATCH";

        const res = await fetch(url, { method, body: fd });
        const raw = await res.text().catch(() => "");
        let data: any = {};
        try { data = raw ? JSON.parse(raw) : {}; } catch { data = {}; }

        if (!res.ok) {
          await cleanupUploaded();
          const message =
            typeof data?.error === "string" && data.error
              ? data.error
              : raw
                ? `HTTP ${res.status}: ${raw.slice(0, 400)}`
                : `HTTP ${res.status}`;
          msg.textContent = message;
          msg.className = "font-sans text-sm text-triba-red bg-triba-red/10 border border-triba-red rounded p-3";
          msg.classList.remove("hidden");
          (window as any).adminToast?.(message, "error");
          return;
        }

        (window as any).adminToast?.(mode === "create" ? "Edición creada" : "Edición actualizada", "success");
        setTimeout(() => { window.location.href = "/admin/ediciones"; }, 800);
      } catch (err: any) {
        await cleanupUploaded();
        msg.textContent = err?.message || "Error de conexión. Intentalo de nuevo.";
        msg.className = "font-sans text-sm text-triba-red bg-triba-red/10 border border-triba-red rounded p-3";
        msg.classList.remove("hidden");
        (window as any).adminToast?.(err?.message || "Error de conexión", "error");
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = mode === "create" ? "Crear edición" : "Guardar cambios";
      }
    });

    async function signAndUpload(kind: "cover" | "pdf", file: File, editionNumber?: number, isFree?: boolean, language?: string): Promise<{ publicUrl: string; path: string | null }> {
      const slug = kind === "pdf" && isFree ? `articulo-gratis-${Date.now()}` : undefined;
      const res = await fetch("/api/admin/uploads/sign", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          kind,
          filename: file.name,
          contentType: file.type,
          size: file.size,
          editionNumber,
          slug,
          language: language || "es",
        }),
      });
      const sign = await res.json().catch(() => ({}));
      if (!res.ok || !sign.signedUrl) {
        throw new Error(sign.error || "Error generando enlace de subida");
      }

      const up = await fetch(sign.signedUrl, {
        method: "PUT",
        headers: { "Content-Type": file.type },
        body: file,
      });
      if (!up.ok) {
        throw new Error("Error subiendo archivo al storage");
      }

      return { publicUrl: sign.publicUrl as string, path: (sign.path as string) || null };
    }

    const deleteBtn = document.getElementById("delete-edition-btn") as HTMLButtonElement | null;
    if (deleteBtn) {
      deleteBtn.addEventListener("click", async () => {
        const id = deleteBtn.dataset.editionId;
        const num = deleteBtn.dataset.editionNumber;
        const confirmed = await (window as any).adminConfirm?.(
          "Eliminar edición",
          num ? `¿Eliminar la edición #${num}? Esta acción no se puede deshacer.` : `¿Eliminar esta edición? Esta acción no se puede deshacer.`
        );
        if (!confirmed) return;
        deleteBtn.disabled = true;
        deleteBtn.textContent = "Eliminando...";
        try {
          const res = await fetch(`/api/admin/editions/${id}`, { method: "DELETE" });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) {
            (window as any).adminToast?.(data.error || "Error eliminando", "error");
            deleteBtn.disabled = false;
            deleteBtn.textContent = "Eliminar";
            return;
          }
          (window as any).adminToast?.("Edición eliminada", "success");
          setTimeout(() => { window.location.href = "/admin/ediciones"; }, 800);
        } catch (err) {
          (window as any).adminToast?.("Error de conexión", "error");
          deleteBtn.disabled = false;
          deleteBtn.textContent = "Eliminar";
        }
      });
    }
  }

  onPageCycle(setupEditionForm);
</script>