---
import Button from "../components/Button.astro";
import { t, type Locale } from "../i18n/ui";
import { localizePath } from "../i18n/locale";

const { lang = "es" } = Astro.props as { lang?: Locale };
const dict = t(lang);
const copy = dict.popup;
---

<style>
  #mailclub-popup-card {
    transition:
      opacity 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      transform 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  #mailclub-popup[data-open="0"] #mailclub-popup-card {
    opacity: 0;
    transform: translateY(16px) scale(0.97);
  }
  #mailclub-popup[data-open="1"] #mailclub-popup-card {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    #mailclub-popup-card {
      transition: none;
    }
  }
</style>

<div id="mailclub-popup" data-open="0" class="hidden fixed inset-0 z-[90] items-center justify-center p-5">
  <div data-popup-backdrop aria-hidden="true" class="absolute inset-0 bg-triba-brown/60 backdrop-blur-[2px]"></div>

  <div
    id="mailclub-popup-card"
    role="dialog"
    aria-modal="true"
    aria-labelledby="mailclub-popup-title"
    class="relative w-full max-w-lg max-h-[90vh] overflow-y-auto rounded-2xl border-2 border-triba-black bg-triba-cream shadow-[6px_6px_0_#35220A]"
  >
    <div class="relative">
      <img src="/fondoPopup.webp" alt="" aria-hidden="true" class="h-64 md:h-80 w-full object-cover object-top" />
      <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-0 h-28 bg-gradient-to-b from-transparent to-triba-cream"></div>
      <span aria-hidden="true" class="absolute top-3 right-3 rounded-full border-2 border-triba-black bg-triba-green px-3 py-1 font-heading text-[11px] uppercase tracking-wider text-triba-brown shadow-[2px_2px_0_#35220A]">✦ {copy.badge}</span>
      <button
        type="button"
        data-popup-close
        aria-label={copy.closeLabel}
        class="absolute top-3 left-3 flex h-9 w-9 items-center justify-center rounded-full border-2 border-triba-black bg-triba-cream font-sans text-lg leading-none text-triba-brown transition-transform hover:scale-105"
      >×</button>
    </div>

    <div class="p-8 md:p-10 text-center">
      <p class="font-heading text-xs font-medium uppercase tracking-[0.2em] text-triba-red mb-3">{copy.eyebrow}</p>
      <h2 id="mailclub-popup-title" class="font-heading text-4xl md:text-5xl text-triba-brown leading-tight mb-3 text-balance">{copy.title}</h2>
      <p class="font-serif italic text-lg md:text-xl text-triba-red mb-3 text-balance">{copy.lead}</p>
      <p class="font-sans text-sm text-triba-brown/80 leading-relaxed mb-6 text-balance">{copy.body}</p>
      <Button variant="primary" size="md" href={localizePath("/mail-club", lang)} class="w-full px-10 py-4 text-base">{copy.cta}</Button>
      <div class="mt-3">
        <button type="button" data-popup-close class="font-sans text-xs text-triba-brown/60 hover:text-triba-red hover:underline min-h-[44px] px-2">{copy.dismiss}</button>
      </div>
    </div>
  </div>
</div>

<script>
  import { onPageCycle } from "../lib/onPageCycle";

  var STORAGE_KEY = "triba-mailclub-popup-seen";
  var hideTimer: number = 0;

  function setupPopup() {
    var root = document.getElementById("mailclub-popup") as HTMLElement | null;
    if (!root || root.dataset.bound === "1") return;
    root.dataset.bound = "1";
    // Fuera de ancestros con transform: el fixed queda relativo al viewport
    // y el z-index manda sobre todo (nav incluido).
    if (root.parentElement !== document.body) document.body.appendChild(root);

    var card = document.getElementById("mailclub-popup-card");
    var closeBtns = root.querySelectorAll("[data-popup-close]");
    var backdrop = root.querySelector("[data-popup-backdrop]");

    function alreadySeen() {
      try {
        return window.sessionStorage.getItem(STORAGE_KEY) === "1";
      } catch {
        return true;
      }
    }

    function markSeen() {
      try {
        window.sessionStorage.setItem(STORAGE_KEY, "1");
      } catch { /* privada: no persiste, se muestra igual una vez */
      }
    }

    function close() {
      root!.dataset.open = "0";
      document.documentElement.style.overflow = "";
      markSeen();
      // Esconde el overlay cuando termina la salida: sin esto el fondo
      // queda montado y la web se ve opaca.
      window.clearTimeout(hideTimer);
      hideTimer = window.setTimeout(function () {
        if (root!.dataset.open === "0") {
          root!.classList.add("hidden");
          root!.classList.remove("flex");
        }
      }, 500);
    }

    function open() {
      window.clearTimeout(hideTimer);
      root!.classList.remove("hidden");
      root!.classList.add("flex");
      requestAnimationFrame(function () {
        root!.dataset.open = "1";
      });
      document.documentElement.style.overflow = "hidden";
      var firstClose = root!.querySelector("[data-popup-close]") as HTMLElement | null;
      if (firstClose) firstClose.focus({ preventScroll: true });
    }

    closeBtns.forEach(function (btn) {
      btn.addEventListener("click", close);
    });
    if (backdrop) backdrop.addEventListener("click", close);
    document.addEventListener("keydown", function onKey(e) {
      if (e.key === "Escape" && root!.dataset.open === "1") close();
    });
    if (card) card.addEventListener("click", function (e) { e.stopPropagation(); });

    if (!alreadySeen()) {
      window.setTimeout(function () {
        if (!alreadySeen()) {
          open();
          markSeen();
        }
      }, 900);
    }
  }

  onPageCycle(setupPopup);
</script>
