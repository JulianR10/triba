---
import FlipCover from "./FlipCover.astro";
import MagazineScroller from "./MagazineScroller.astro";
import type { Locale } from "../i18n/ui";

export interface Edition {
  id: number;
  edition: string;
  title: string;
  description: string;
  cover: string;
  pdf: string;
  featured: boolean;
  badge: string | null;
  flipColor?: string;
  backTextClass?: string;
}

export interface Props {
  editions: Edition[];
  selectedId?: number;
  lang?: Locale;
}

const { editions, selectedId, lang = "es" } = Astro.props;
const ariaLabel = lang === "en" ? "Editions carousel" : "Carrusel de ediciones";
const coverAlt = lang === "en" ? "Cover of edition" : "Portada de edición";
---

<MagazineScroller
  arrows
  keyboard
  ariaLabel={ariaLabel}
  scrollClass="py-8 md:py-10"
  trackClass="[&>*:first-child]:ml-auto [&>*:last-child]:mr-auto"
  rootData={{ "data-carousel": "" }}
>
  {editions.map((ed) => (
    <div
      data-scroller-item
      data-edition-id={ed.id}
      data-edition-name={ed.edition}
      data-title={ed.title}
      data-description={ed.description}
      data-cover={ed.cover}
      data-pdf={ed.pdf}
      data-badge={ed.badge || ''}
      data-featured={ed.featured}
      role="option"
      aria-selected={ed.id === selectedId}
      tabindex="0"
      class="snap-center shrink-0 w-[72vw] sm:w-[40vw] md:w-[30%] cursor-pointer focus-visible:outline-2 focus-visible:outline-triba-red focus-visible:outline-offset-2 rounded-xl"
    >
      <FlipCover
        image={ed.cover}
        alt={`${coverAlt} ${ed.edition}`}
        flipColor={ed.flipColor}
        backTextClass={ed.backTextClass}
        rounded="rounded-xl"
        textSize="text-sm"
        pad="p-4"
        badge={ed.badge}
        lang={lang}
      />
    </div>
  ))}
</MagazineScroller>