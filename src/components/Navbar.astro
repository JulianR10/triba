---
import { createSupabaseServerClient } from "../lib/supabase-server";
import AccountMenuItems from "./AccountMenuItems.astro";
import { t, type Locale } from "../i18n/ui";
import { localizePath, switchPath } from "../i18n/locale";

const { showLogoAlways = false, lang = "es" } = Astro.props as {
  showLogoAlways?: boolean;
  lang?: Locale;
};

const dict = t(lang);
const currentPath = Astro.url.pathname;

const supabase = createSupabaseServerClient(Astro.request);
const {
  data: { session },
} = await supabase.auth.getSession();
const isLoggedIn = !!session;

const user = session?.user ?? null;

let profileRole: string | null = null;
let accountSub: any = null;
if (user) {
  const { data: p } = await supabase.from("profiles").select("role, subscription_id").eq("id", user.id).single();
  profileRole = p?.role ?? null;
  if (p?.subscription_id) {
    const { data: s } = await supabase
      .from("subscriptions")
      .select("status, provider, plan_currency, current_period_end")
      .eq("id", p.subscription_id)
      .single();
    accountSub = s;
  }
}

function formatPeriodEnd(iso?: string | null) {
  if (!iso) return "";
  const d = new Date(iso);
  if (isNaN(d.getTime())) return "";
  return d.toLocaleDateString(dict.dateLocale, { day: "2-digit", month: "short", year: "numeric" });
}

const periodEndLabel = formatPeriodEnd(accountSub?.current_period_end);

const publicLinks = [
  { href: "/", label: dict.nav.home },
  { href: "/revista", label: dict.nav.magazine },
  { href: "/suscribirme", label: dict.nav.subscribe },
  { href: "/triba-creators", label: dict.nav.creators },
];

const authLinks = [
  { href: "/", label: dict.nav.home },
  { href: "/revista", label: dict.nav.magazine },
  { href: "/triba-creators", label: dict.nav.creators },
];

const localized = publicLinks.map((link) => ({ ...link, href: localizePath(link.href, lang) }));
const localizedAuth = authLinks.map((link) => ({ ...link, href: localizePath(link.href, lang) }));

const esHref = switchPath(currentPath, "es");
const enHref = switchPath(currentPath, "en");
---

<style>
  .slide-in {
    transform: translateX(0);
  }

  #navbar {
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    padding-top: calc(1rem + env(safe-area-inset-top));
  }

  #menu-toggle {
    top: calc(1rem + env(safe-area-inset-top));
  }

  #mobile-menu {
    padding-top: env(safe-area-inset-top);
    padding-bottom: env(safe-area-inset-bottom);
  }

  #navbar.nav-hidden {
    transform: translateY(-100%);
  }

  #mi-cuenta-dropdown {
    transform-origin: top right;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  #mi-cuenta-dropdown.hidden {
    opacity: 0;
    transform: scale(0.95);
    pointer-events: none;
  }

  #mi-cuenta-dropdown:not(.hidden) {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
  }

  
</style>

<nav id="navbar" data-logo-always={showLogoAlways ? "1" : "0"} class="hidden md:flex fixed top-0 left-0 right-0 z-40 items-center px-5 py-4 md:px-10 lg:px-20 bg-triba-bone/80 backdrop-blur-sm">
  <div class="grid grid-cols-3 items-center w-full max-w-6xl mx-auto">
    <div class="flex items-center">
      <span></span>
    </div>

    <div class="flex items-center justify-center gap-8">
      {
        isLoggedIn
          ? localizedAuth.map((link) => (
              <a
                href={link.href}
                class="font-heading text-sm font-medium uppercase tracking-wide text-triba-red transition-colors hover:text-triba-brown focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-triba-red focus-visible:ring-offset-2 rounded"
              >
                {link.label}
              </a>
            ))
          : localized.map((link) => (
              <a
                href={link.href}
                class="font-heading text-sm font-medium uppercase tracking-wide text-triba-red transition-colors hover:text-triba-brown focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-triba-red focus-visible:ring-offset-2 rounded"
              >
                {link.label}
              </a>
            ))
      }
    </div>

    <div class="flex justify-end items-center gap-4">
      <div class="flex items-center border-2 border-triba-black rounded-full overflow-hidden font-heading text-xs uppercase tracking-wider" role="group" aria-label="Language">
        <a
          href={esHref}
          data-locale-switcher="es"
          class={"px-3 py-1.5 transition-colors " + (lang === "es" ? "bg-triba-red text-triba-white" : "text-triba-brown hover:bg-triba-pink/40")}
          aria-current={lang === "es" ? "true" : undefined}
        >ES</a>
        <a
          href={enHref}
          data-locale-switcher="en"
          class={"px-3 py-1.5 transition-colors " + (lang === "en" ? "bg-triba-red text-triba-white" : "text-triba-brown hover:bg-triba-pink/40")}
          aria-current={lang === "en" ? "true" : undefined}
        >EN</a>
      </div>
      {
        isLoggedIn
          ? <div class="relative">
              <button id="mi-cuenta-btn" class="rounded-button bg-triba-red px-6 py-2.5 font-heading text-sm font-medium uppercase text-triba-white border-2 border-triba-black transition-all hover:scale-[1.02] active:scale-[0.98] flex items-center gap-2">
                {dict.nav.myAccount}
                <svg class="w-3 h-3 fill-current" viewBox="0 0 10 6"><path d="M0 0l5 6 5-6z"/></svg>
              </button>
              <div id="mi-cuenta-dropdown" class="hidden absolute right-0 top-full mt-2 w-64 bg-triba-white border-2 border-triba-black rounded-xl shadow-xl overflow-hidden z-50">
                <div class="p-4" id="mi-cuenta-content">
                  <AccountMenuItems role={profileRole} sub={accountSub} periodEndLabel={periodEndLabel} lang={lang} />
                </div>
              </div>
            </div>
          : <a href={localizePath("/iniciar-sesion", lang)} class="rounded-button bg-triba-red px-6 py-2.5 font-heading text-sm font-medium uppercase text-triba-white border-2 border-triba-black transition-all hover:scale-[1.02] active:scale-[0.98]">{dict.nav.signIn}</a>
      }
    </div>
  </div>
</nav>

<button id="menu-toggle" class="fixed top-4 right-4 z-50 md:hidden flex flex-col gap-1.5 p-3.5 bg-gradient-to-br from-triba-pink to-triba-white shadow-lg border-none cursor-pointer" style="clip-path: polygon(5% 0%, 100% 3%, 97% 93%, 0% 100%)" aria-label={dict.nav.menu}>
  <span class="h-0.5 w-7 bg-triba-black block transition-all duration-300 origin-center"></span>
  <span class="h-0.5 w-7 bg-triba-black block transition-all duration-300"></span>
  <span class="h-0.5 w-7 bg-triba-black block transition-all duration-300 origin-center"></span>
</button>

<div id="menu-overlay" class="fixed inset-0 z-40 bg-black/40 hidden md:hidden"></div>

<div id="mobile-menu" class="fixed top-0 right-0 z-40 h-full w-80 max-w-[85vw] bg-triba-white shadow-2xl flex flex-col md:hidden translate-x-full transition-transform duration-300">
  <div class="flex items-center justify-between px-6 py-5 border-b border-triba-black/10">
    <a href={localizePath("/", lang)}><img src="/logo-triba.svg" alt="Triba" class="h-8" /></a>
  </div>

  <div class="flex-1 flex flex-col gap-1 px-6 pt-6">
    {
      (isLoggedIn ? localizedAuth : localized.filter((l) => l.href !== "/")).map((link) => (
        <a
          href={link.href}
          class="font-heading text-lg font-medium uppercase tracking-wide text-triba-red py-3 border-b border-triba-black/10 transition-colors hover:text-triba-brown focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-triba-red focus-visible:ring-inset"
        >
          {link.label}
        </a>
      ))
    }

    <div class="flex items-center gap-2 pt-4 pb-2" role="group" aria-label="Language">
      <a
        href={esHref}
        data-locale-switcher="es"
        class={"px-3 py-1.5 border-2 border-triba-black rounded-full font-heading text-xs uppercase tracking-wider transition-colors " + (lang === "es" ? "bg-triba-red text-triba-white" : "text-triba-brown")}
        aria-current={lang === "es" ? "true" : undefined}
      >ES</a>
      <a
        href={enHref}
        data-locale-switcher="en"
        class={"px-3 py-1.5 border-2 border-triba-black rounded-full font-heading text-xs uppercase tracking-wider transition-colors " + (lang === "en" ? "bg-triba-red text-triba-white" : "text-triba-brown")}
        aria-current={lang === "en" ? "true" : undefined}
      >EN</a>
    </div>

    {
      isLoggedIn && (
        <div id="mobile-mi-cuenta-items" class="border-b border-triba-black/10 py-3">
          <AccountMenuItems role={profileRole} sub={accountSub} periodEndLabel={periodEndLabel} />
        </div>
      )
    }
  </div>

  <div class="px-6 pb-8 pt-4 border-t border-triba-black/10">
    {
      isLoggedIn
        ? <button id="logout-btn-mobile" class="rounded-button bg-triba-red px-6 py-3 font-heading text-sm font-medium uppercase text-triba-white border-2 border-triba-black transition-all hover:scale-[1.02] active:scale-[0.98] w-full block text-center">{dict.nav.signOut}</button>
        : <a href={localizePath("/iniciar-sesion", lang)} class="rounded-button bg-triba-red px-6 py-3 font-heading text-sm font-medium uppercase text-triba-white border-2 border-triba-black transition-all hover:scale-[1.02] active:scale-[0.98] w-full block text-center">{dict.nav.signIn}</a>
    }
  </div>
</div>

<script>
  import { supabase } from "../lib/supabase";
  import { showToast, showConfirm } from "../lib/ui";
  import { onPageCycle } from "../lib/onPageCycle";

  declare global {
    interface Window {
      _navScrollHandler?: () => void;
      _navObserver?: ResizeObserver;
    }
  }

  function setupNav() {
    if (window._navScrollHandler) {
      window.removeEventListener("scroll", window._navScrollHandler);
    }
    if (window._navObserver) {
      window._navObserver.disconnect();
    }

    var nav = document.getElementById("navbar")!;
    if (!nav) return;

    var root = document.documentElement;

    function updateNavHeight() {
      root.style.setProperty("--nav-height", nav.offsetHeight + "px");
    }

    updateNavHeight();

    var lastScrollY = window.scrollY;
    var tickingNav = false;

    function onNavScroll() {
      if (!tickingNav) {
        requestAnimationFrame(function () {
          var currentScrollY = window.scrollY;
          var menuEl = document.getElementById("mobile-menu");
          var menuOpen = !!menuEl && !menuEl.classList.contains("translate-x-full");

          if (!menuOpen && currentScrollY > 80) {
            if (currentScrollY > lastScrollY) {
              nav.classList.add("nav-hidden");
            } else {
              nav.classList.remove("nav-hidden");
            }
          } else {
            nav.classList.remove("nav-hidden");
          }

          lastScrollY = currentScrollY;
          tickingNav = false;
        });
        tickingNav = true;
      }
    }

    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      window._navScrollHandler = onNavScroll;
      window.addEventListener("scroll", onNavScroll, { passive: true });
    }

    var observer = new ResizeObserver(updateNavHeight);
    window._navObserver = observer;
    observer.observe(nav);

    var toggle = document.getElementById("menu-toggle");
    var menu = document.getElementById("mobile-menu")!;
    var overlay = document.getElementById("menu-overlay")!;
    var spans = toggle ? toggle.querySelectorAll("span") : [];
    var isOpen = false;

    function openMenu() {
      isOpen = true;
      overlay.classList.remove("hidden");
      menu.classList.remove("translate-x-full");
      menu.classList.add("slide-in");
      document.body.style.overflow = "hidden";
      if (spans.length === 3) {
        spans[0].style.transform = "rotate(45deg) translate(5px, 5px)";
        spans[1].style.opacity = "0";
        spans[2].style.transform = "rotate(-45deg) translate(5px, -5px)";
      }
    }

    function closeMenu() {
      isOpen = false;
      menu.classList.add("translate-x-full");
      menu.classList.remove("slide-in");
      overlay.classList.add("hidden");
      document.body.style.overflow = "";
      if (spans.length === 3) {
        spans[0].style.transform = "";
        spans[1].style.opacity = "";
        spans[2].style.transform = "";
      }
    }

    if (toggle) {
      toggle.addEventListener("click", function () {
        if (isOpen) {
          closeMenu();
        } else {
          openMenu();
        }
      });
    }

    if (overlay) {
      overlay.addEventListener("click", closeMenu);
    }

    if (menu) {
      menu.querySelectorAll("a").forEach(function (link) {
        link.addEventListener("click", closeMenu);
      });
    }

    // --- MI CUENTA dropdown ---
    setupMiCuentaDropdown();

    // --- Logout (mobile) ---
    var logoutBtn = document.getElementById("logout-btn-mobile");
    if (logoutBtn) logoutBtn.addEventListener("click", logout);
  }

  function setupMiCuentaDropdown() {
    var btn = document.getElementById("mi-cuenta-btn");
    var dropdown = document.getElementById("mi-cuenta-dropdown");

    if (btn && dropdown && !btn.dataset.bound) {
      btn.dataset.bound = "1";
      btn.addEventListener("click", function (e) {
        e.stopPropagation();
        dropdown!.classList.toggle("hidden");
      });

      document.addEventListener("click", function (e) {
        var target = e.target as Node | null;
        if (!dropdown!.classList.contains("hidden") &&
            !dropdown!.contains(target) &&
            target !== btn &&
            !btn!.contains(target)) {
          dropdown!.classList.add("hidden");
        }
      });
    }
  }

  async function logout() {
    if (supabase) await supabase.auth.signOut();
    window.location.href = "/";
  }

  async function openManage() {
    var { data: { session } } = await supabase!.auth.getSession();
    if (!session) return;
    try {
      var res = await fetch("/api/portal", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: "Bearer " + session.access_token,
        },
      });
      var data = await res.json();
      if (data.url) { window.location.href = data.url; return; }
      if (data.note) { alert(data.note); return; }
      throw new Error(data.error || "Error");
    } catch (e) {
      alert("Error al abrir el portal de gestión");
    }
  }

  async function cancelSub(btn: HTMLButtonElement) {
    var confirmed = await showConfirm(
      "Cancelar suscripción",
      "¿Estás segura? Perderás el acceso a la revista al final del período actual."
    );
    if (!confirmed) return;

    var { data: { session } } = await supabase!.auth.getSession();
    if (!session) return;

    btn.disabled = true;
    btn.textContent = "Cancelando...";
    try {
      var res = await fetch("/api/cancel-subscription", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: "Bearer " + session.access_token,
        },
      });
      var data = await res.json();
      if (data.ok) {
        showToast("Suscripción cancelada", "success");
        if (data.providerWarnings && data.providerWarnings.length > 0) {
          var warnMsg = "Cancelada en Triba, pero hubo un problema con el proveedor de pago: " + data.providerWarnings.join(". ");
          setTimeout(function () { alert(warnMsg); }, 500);
        }
        setTimeout(function () { window.location.reload(); }, 1500);
      } else {
        alert(data.error || "Error al cancelar");
        btn.disabled = false;
        btn.textContent = "Cancelar suscripción";
      }
    } catch (e) {
      alert("Error de conexión");
      btn.disabled = false;
      btn.textContent = "Cancelar suscripción";
    }
  }

  function bindAccountActions() {
    if ((window as any)._accountActionsBound) return;
    (window as any)._accountActionsBound = true;

    document.addEventListener("click", function (e) {
      var target = e.target as HTMLElement | null;
      if (!target) return;

      if (target.closest(".logout-dropdown-btn")) { logout(); return; }
      if (target.closest(".manage-sub-btn")) { openManage(); return; }

      var cancelBtn = target.closest(".cancel-sub-btn");
      if (cancelBtn) { cancelSub(cancelBtn as HTMLButtonElement); }
    });
  }

  function setupLocaleSwitcher() {
    if ((window as any)._localeSwitcherBound) return;
    (window as any)._localeSwitcherBound = true;

    document.querySelectorAll<HTMLAnchorElement>("[data-locale-switcher]").forEach(function (link) {
      link.addEventListener("click", function () {
        var locale = link.dataset.localeSwitcher || "";
        document.cookie =
          "triba_locale=" + encodeURIComponent(locale) +
          "; path=/; max-age=31536000; SameSite=Lax";
        if (supabase) {
          supabase.auth.getSession().then(function ({ data }) {
            var session = data.session;
            if (!session) return;
            fetch("/api/locale", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                Authorization: "Bearer " + session.access_token,
              },
              body: JSON.stringify({ locale: locale === "en" ? "en" : "es" }),
            }).catch(function () {});
          });
        }
      });
    });
  }

  bindAccountActions();
  setupLocaleSwitcher();
  onPageCycle(setupNav);
</script>
